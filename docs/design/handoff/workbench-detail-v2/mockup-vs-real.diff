+.wb3-stack-lock > span { border: 1px dashed var(--border-strong); border-radius: 10px; padding: 18px 24px; color: var(--text-faint); font-size: 12.5px; width: 100%; text-align: center; }
+.wb3-stack .hs-rd { font: 500 11.5px var(--mono); color: var(--text-secondary); }
+
+/* The notice line (the only job the footer keeps). */
