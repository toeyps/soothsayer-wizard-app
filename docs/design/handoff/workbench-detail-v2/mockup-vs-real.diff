+/* The scoring-period tile label: two lines, never cut. */
+.wb3-kpi-l:has(.wb3-kpi-l2) { white-space: normal; overflow: visible; }
+.wb3-kpi-l2 { display: flex; flex-direction: column; gap: 1px; min-width: 0; font-family: var(--mono); letter-spacing: 0; text-transform: none; font-size: 10.5px; }
