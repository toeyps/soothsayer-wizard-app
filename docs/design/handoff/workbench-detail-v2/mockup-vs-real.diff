new file mode 100644
index 0000000..6a2ce93
--- /dev/null
+++ b/mock_now/src/components/windows/workbench/Kpi.tsx
@@ -0,0 +1,34 @@
+import type { ReactNode } from 'react';
+
+/*
+ * cur5 direction — a KPI tile: ONE big number the user reads first, its unit,
+ * a small caption under it. A row of these (`.wb3-kpis`) replaces the
+ * "Statistics" table on the Model fit page and the score summary sentence on
+ * the Health score page. Tiles never judge (no verdict colours) except `tone`,
+ * which only flags a number worth a second look (amber) or a score colour.
+ */
+export function Kpi({ label, value, unit, sub, tone, small, testId, children }: {
+    label: ReactNode;
+    value: ReactNode;
+    unit?: string;
+    sub?: ReactNode;
+    /** `ok` / `warn` / `bad` colour the value (score colours); absent = plain. */
+    tone?: 'ok' | 'warn' | 'bad';
+    /** A date or a word instead of a number: smaller type. */
+    small?: boolean;
+    testId?: string;
+    /** Extra content under the value (a bar, a list). */
+    children?: ReactNode;
+}) {
+    return (
+        <div className={`wb3-kpi${tone ? ` wb3-kpi--${tone}` : ''}`} data-testid={testId}>
+            <div className="wb3-kpi-l">{label}</div>
+            <div className={`wb3-kpi-v${small ? ' wb3-kpi-v--sm' : ''}`}>
+                {value}
+                {unit && <span className="wb3-kpi-u">{unit}</span>}
+            </div>
+            {children}
+            {sub && <div className="wb3-kpi-s">{sub}</div>}
+        </div>
+    );
+}
