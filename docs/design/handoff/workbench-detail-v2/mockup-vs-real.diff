+.wb3-kindtabs .f4-tab { padding: 10px 12px 9px; font-size: 0.78rem; }
+.wb3-tab-state { display: inline-flex; align-items: center; gap: 5px; margin-left: 2px; }
+.wb3-tab-words { font-size: 0.66rem; font-weight: 500; color: var(--text-secondary); white-space: nowrap; max-width: 300px; overflow: hidden; text-overflow: ellipsis; }
+.wb3-tab-words--need { color: var(--warn); }
+.wb3-tab-words--bad { color: var(--danger); }
+.wb3-tab-words--complete { color: var(--ok); }
+.f4-tab--on .wb3-tab-words { font-weight: 600; }
+
+/* Page tabs under the kind tabs: the two steps of a model. */
+.wb3-pages { display: flex; gap: 4px; padding: 8px 14px 0; border-bottom: 1px solid var(--border); background: var(--bg-primary); }
+.wb3-page { display: inline-flex; align-items: center; gap: 8px; height: 38px; padding: 0 14px; border: 0; border-bottom: 2px solid transparent; margin-bottom: -1px; background: none; color: var(--text-secondary); font: inherit; font-size: 12.5px; font-weight: 500; cursor: pointer; white-space: nowrap; border-radius: 6px 6px 0 0; }
+.wb3-page:hover:not(.wb3-page--off) { color: var(--text-primary); background: var(--hover-bg); }
+.wb3-page--on { color: var(--text-primary); font-weight: 600; border-bottom-color: var(--accent-color); }
+.wb3-page--off { cursor: not-allowed; }
+.wb3-page--off .wb3-page-n, .wb3-page--off .wb3-page-t { opacity: 0.45; }
+.wb3-page:focus-visible { outline: 2px solid var(--accent-color); outline-offset: -2px; }
+.wb3-page-n { width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; font: 700 10px var(--mono); background: var(--surface-hi); color: var(--text-secondary); border: 1px solid var(--border-strong); }
+.wb3-page--on .wb3-page-n { background: var(--accent-color); color: #06111f; border-color: transparent; }
+.wb3-page-s { font-size: 10.5px; font-weight: 400; color: var(--text-faint); }
+.wb3-page--off .wb3-page-s { color: var(--warn); font-weight: 500; }
+
+/* Boards: more room between cards, cards lifted off the window. */
+.wb3-board { gap: 14px; padding: 14px 20px 18px; }
+.wb3-board .wb2-card, .wb3-board .hs-card { background: var(--card-bg); border-color: var(--border-strong); box-shadow: 0 1px 0 rgba(255, 255, 255, 0.02) inset, 0 8px 24px rgba(0, 0, 0, 0.25); border-radius: 14px; padding: 12px 14px 10px; }
+.wb3-board .wb2-card-h b { font-size: 13.5px; }
+.wb3-board .wb2-card-s { font-size: 11.5px; color: var(--text-secondary); }
+.wb3-board .wb2-card--xtall .wb2-cv { height: 400px; }
+.wb3-board .wb2-card--normal .wb2-cv { height: 220px; }
+.wb3-board .wb2-stale, .wb3-board .rcm-warn, .wb3-board .hs-save { margin: 0; grid-column: 1 / -1; }
+
+/* KPI strip: the numbers first. */
+.wb3-kpis { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }
+/* Model fit: 3 tiles, left-aligned and capped so they do not stretch on a wide window */
+.wb3-kpis--fit { grid-template-columns: repeat(3, minmax(0, 420px)); justify-content: start; }
+.wb3-kpi { background: var(--card-bg); border: 1px solid var(--border-strong); border-radius: 12px; padding: 10px 14px 9px; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
+.wb3-kpi-l { font-size: 10.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-secondary); display: flex; align-items: center; gap: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.wb3-kpi-l .tpe-sw { flex-shrink: 0; }
+.wb3-kpi-v { font: 600 24px var(--mono); letter-spacing: -0.03em; color: var(--text-primary); line-height: 1.15; display: flex; align-items: baseline; gap: 6px; white-space: nowrap; overflow: hidden; }
+.wb3-kpi-v--sm { font-size: 13.5px; letter-spacing: -0.01em; padding-top: 5px; white-space: normal; line-height: 1.3; }
+.wb3-kpi-u { font-size: 11px; font-weight: 500; color: var(--text-secondary); letter-spacing: 0; }
+.wb3-kpi-s { font-size: 11px; color: var(--text-secondary); line-height: 1.4; }
+.wb3-kpi-s b { color: var(--text-primary); font-weight: 600; font-family: var(--mono); }
+.wb3-kpi--ok .wb3-kpi-v { color: var(--ok); }
+.wb3-kpi--warn .wb3-kpi-v { color: var(--warn); }
+.wb3-kpi--bad .wb3-kpi-v { color: var(--danger); }
+.wb3-sharebar { display: flex; width: 100%; height: 10px; border-radius: 5px; overflow: hidden; background: rgba(255, 255, 255, 0.06); margin: 6px 0 2px; }
+.wb3-sharebar i { display: block; height: 100%; }
+.wb3-sharekey { display: flex; gap: 10px; font-size: 10.5px; color: var(--text-faint); flex-wrap: wrap; }
