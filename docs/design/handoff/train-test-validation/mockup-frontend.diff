+// ---------------------------------------------------------------------------
+// MOCKUP (Train/Test validation, 2026-10-07): time scopes on every time chart
+// ---------------------------------------------------------------------------
+
+export interface TimeScope {
+    kind: 'train' | 'normal' | 'problem';
+    start: string | null;
+    end: string | null;
+    /** Pill text at the top of the band: "TRAIN P1", "T1 NORMAL", "T2 KNOWN PROBLEM". */
+    label: string;
+    /** Shorter pill for narrow charts: "P1", "T1 NORMAL", "T2 PROBLEM". */
+    short: string;
+}
+export interface TimeScopes {
+    ranges: TimeScope[];
+    /** Known-problem event times (red dashed vertical line labelled EVENT). */
+    events: string[];
+    /** Use the short pill labels (charts narrower than ~520 px). */
+    compact?: boolean;
+}
+
+/** Scope colours: train = accent blue, test = magenta (DESIGN_SYSTEM §4 Train / Test periods). */
+export const SCOPE = {
+    train: 'rgba(77, 140, 240, 0.10)',
+    trainLine: '#5b95f0',
+    test: 'rgba(232, 102, 196, 0.11)',
+    testLine: '#e866c4',
+};
+
+/** The scopes the Workbench page is currently drawing. The page sets it from
+ *  `HealthPreview.test_validation` before building its options, so every chart
+ *  that goes through `buildTimeSeriesOption` gets the bands without each
+ *  builder having to pass them on (an implementation should thread it through
+ *  `TimeSeriesSpec.scopes` explicitly). */
+let activeScopes: TimeScopes | null = null;
+export function setActiveTimeScopes(s: TimeScopes | null) { activeScopes = s; }
+/** Build one option with the short pill labels (half-width charts), then restore. */
+export function withCompactScopes<T>(build: () => T): T {
+    const prev = activeScopes;
+    activeScopes = prev ? { ...prev, compact: true } : prev;
+    try { return build(); } finally { activeScopes = prev; }
+}
+/** Height kept free above the plot for the scope pills. */
+const SCOPE_STRIP = 18;
+
+let hatchCache: unknown = null;
+/** 135° magenta hatch for Known problem bands (canvas pattern; plain fill outside a browser). */
+function problemFill(): unknown {
+    if (hatchCache) return hatchCache;
+    if (typeof document === 'undefined') return SCOPE.test;
+    const c = document.createElement('canvas');
+    c.width = 8; c.height = 8;
+    const g = c.getContext('2d');
+    if (!g) return SCOPE.test;
+    g.fillStyle = 'rgba(232, 102, 196, 0.07)';
+    g.fillRect(0, 0, 8, 8);
+    g.strokeStyle = 'rgba(232, 102, 196, 0.28)';
+    g.lineWidth = 1.2;
+    g.beginPath(); g.moveTo(0, 8); g.lineTo(8, 0); g.moveTo(-2, 2); g.lineTo(2, -2); g.moveTo(6, 10); g.lineTo(10, 6); g.stroke();
+    hatchCache = { image: c, repeat: 'repeat' };
+    return hatchCache;
+}
+
+const tsMs = (s: string | null | undefined): number | null => {
+    if (!s) return null;
+    const t = new Date(s.includes('T') ? s : s.replace(' ', 'T')).getTime();
+    return Number.isFinite(t) ? t : null;
+};
+
+function scopeMarks(scopes: TimeScopes, xMin: number, xMax: number, yTop: number) {
+    const area = scopes.ranges.map(r => {
+        const a = tsMs(r.start) ?? xMin;
+        const b = tsMs(r.end) ?? xMax;
+        const fill = r.kind === 'train' ? SCOPE.train : r.kind === 'problem' ? problemFill() : SCOPE.test;
+        const col = r.kind === 'train' ? SCOPE.trainLine : SCOPE.testLine;
+        return [
+            {
+                xAxis: a,
+                // Train and test may overlap (2026-10-07): train = blue fill, test = magenta
+                // fill + dashed outline, so a test drawn over train time stays readable.
+                itemStyle: r.kind === 'train'
+                    ? { color: fill, borderWidth: 0 }
+                    : { color: fill, borderColor: col, borderWidth: 1, borderType: 'dashed' },
+                // Pills sit in their own strip ABOVE the plot, so they never meet the
+                // reference-line labels (those move to the left end when scopes show).
+                label: {
+                    // Two pill lanes: train pills above the plot, test pills on the first row inside it.
+                    show: true, position: r.kind === 'train' ? 'top' : 'insideTop', formatter: scopes.compact ? r.short : r.label, distance: 3,
+                    color: col, fontSize: 9, fontWeight: 700, fontFamily: 'JetBrains Mono, monospace',
+                    backgroundColor: 'rgba(10, 10, 11, 0.82)', padding: [2, 5], borderRadius: 4,
+                },
+            },
+            { xAxis: b },
+        ];
+    });
+    const evMs = scopes.events.map(e => tsMs(e)).filter((x): x is number => x !== null);
+    const lines = evMs.map(x => ({
+        xAxis: x,
+        lineStyle: { color: CHART.danger, width: 1.5, type: 'dashed' },
+        label: { show: false },
+    }));
+    // EVENT label: one row below the pill strip, just inside the plot.
+    const points = evMs.map(x => ({
+        coord: [x, yTop],
+        symbol: 'circle',
+        symbolSize: 0,
+        label: {
+            show: true, formatter: 'EVENT', position: 'bottom', distance: 24,
+            color: CHART.danger, fontSize: 9, fontWeight: 700, fontFamily: 'JetBrains Mono, monospace',
+            backgroundColor: 'rgba(10, 10, 11, 0.82)', padding: [2, 4], borderRadius: 3,
+        },
+    }));
+    return { area, lines, points };
+}
