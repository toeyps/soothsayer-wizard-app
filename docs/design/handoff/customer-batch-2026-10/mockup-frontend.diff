index 0000000..890bf76
--- /dev/null
+++ b/cur3/app/src/components/sensor/ColourPicker.tsx
@@ -0,0 +1,129 @@
+import { useEffect, useRef, useState } from 'react';
+import { Check, ChevronRight } from 'lucide-react';
+import AnchoredPopover, { type PopoverAnchorRect } from '../AnchoredPopover';
+import ColorPlatePicker from '../dashboard/ColorPlatePicker';
+
+/**
+ * MOCKUP (customer item 4, 2026-10-08): ONE colour picker (DESIGN_SYSTEM §4 "Colour picking").
+ * The 16 px swatch IS the button (24 px hit area). Popover: 12 palette swatches in the §4 order,
+ * a ring on the current colour, a dot on colours other items on the same chart use, then
+ * "Custom colour" (HSV plate + hue + hex). Picks apply immediately.
+ */
+export const PALETTE = ['#3b82f6', '#10b981', '#f43f5e', '#8b5cf6', '#06b6d4', '#84cc16', '#d946ef', '#f97316', '#f59e0b', '#14b8a6', '#6366f1', '#ec4899'];
+const norm = (c: string) => c.trim().toLowerCase();
+
+export default function ColourPicker({ color, onChange, used = [], label, title }: {
+  color: string;
+  onChange: (hex: string) => void;
+  /** Colours other items on the same chart already use (they get a dot). */
+  used?: string[];
+  /** Popover heading, e.g. the sensor name or "Range 2". */
+  label?: string;
+  title?: string;
+}) {
+  const [rect, setRect] = useState<PopoverAnchorRect | null>(null);
+  const [custom, setCustom] = useState(false);
+  const [hex, setHex] = useState(color);
+  const btn = useRef<HTMLButtonElement>(null);
+  useEffect(() => setHex(color), [color]);
+  const open = () => {
+    const r = btn.current!.getBoundingClientRect();
+    setCustom(!PALETTE.some(p => norm(p) === norm(color)));
+    setRect({ top: r.top, bottom: r.bottom, left: r.left, right: r.right });
+  };
+  const close = (focus = true) => { setRect(null); if (focus) requestAnimationFrame(() => btn.current?.focus()); };
+  useEffect(() => {
+    if (!rect) return;
+    const onDown = (e: MouseEvent) => {
+      const t = e.target as Element;
+      if (btn.current?.contains(t) || t.closest?.('.cp-pop')) return;
+      close(false);
+    };
+    document.addEventListener('mousedown', onDown, true);
+    return () => document.removeEventListener('mousedown', onDown, true);
+  }, [rect]);
+  const usedSet = new Set(used.map(norm));
+  const validHex = /^#[0-9a-f]{6}$/i.test(hex);
+  const onGridKey = (e: React.KeyboardEvent, i: number) => {
+    const move = { ArrowRight: 1, ArrowLeft: -1, ArrowDown: 6, ArrowUp: -6 }[e.key];
+    if (move) {
+      e.preventDefault();
+      const n = Math.max(0, Math.min(PALETTE.length - 1, i + move));
+      (e.currentTarget.parentElement?.children[n] as HTMLElement | undefined)?.focus();
+    }
+  };
+  return (
+    <>
+      <button
+        ref={btn}
+        type="button"
+        className="cp-hit"
+        title={title ?? 'Colour'}
+        aria-label={title ?? 'Colour'}
+        aria-haspopup="dialog"
+        aria-expanded={!!rect}
+        onClick={(e) => { e.stopPropagation(); rect ? close() : open(); }}
+      >
+        <span className="cp-trigger" style={{ background: color }} />
+      </button>
+      {rect && (
+        <AnchoredPopover anchorRect={rect} onRequestClose={() => close(false)} style={{ width: 228, padding: 0, maxHeight: 'none', overflow: 'visible' }}>
+          <div
+            className="cp-pop"
+            role="dialog"
+            aria-label={`Colour${label ? ` for ${label}` : ''}`}
+            onKeyDown={e => {
+              if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); close(); }
+              if (e.key === 'Tab' && !e.shiftKey) {
+                const f = [...e.currentTarget.querySelectorAll<HTMLElement>('button,input')];
+                if (document.activeElement === f[f.length - 1]) close(false);
+              }
+            }}
+          >
+            <div className="cp-head"><span>{label ?? 'Colour'}</span><span className="hex">{color}</span></div>
+            <div className="cp-grid" role="radiogroup" aria-label="Palette">
+              {PALETTE.map((p, i) => {
+                const sel = norm(p) === norm(color);
+                return (
+                  <button
+                    key={p}
+                    type="button"
+                    role="radio"
+                    aria-checked={sel}
+                    autoFocus={sel || (i === 0 && !PALETTE.some(q => norm(q) === norm(color)))}
+                    className={`cp-sw${sel ? ' sel' : ''}`}
+                    style={{ background: p }}
+                    title={`${p}${usedSet.has(norm(p)) && !sel ? ' · in use on this chart' : ''}`}
+                    onKeyDown={e => onGridKey(e, i)}
+                    onClick={() => onChange(p)}
+                  >
+                    {sel && <span className="chk"><Check size={12} strokeWidth={3} /></span>}
+                    {!sel && usedSet.has(norm(p)) && <span className="used" />}
+                  </button>
+                );
+              })}
+            </div>
+            <div className="cp-legend"><span><i />In use on this chart</span></div>
+            <button type="button" className="cp-custom" aria-expanded={custom} onClick={() => setCustom(c => !c)}>
+              <span>Custom colour</span><ChevronRight size={12} className="car" />
+            </button>
+            {custom && (
+              <div className="cp-adv">
+                <ColorPlatePicker color={validHex ? hex : color} onChange={(h) => { setHex(h); onChange(h); }} />
+                <div className="cp-hexrow">
+                  <input
+                    value={hex}
+                    aria-label="Hex colour"
+                    className={validHex ? '' : 'bad'}
+                    onChange={e => { const v = e.target.value.startsWith('#') ? e.target.value : `#${e.target.value}`; setHex(v); if (/^#[0-9a-f]{6}$/i.test(v)) onChange(v.toLowerCase()); }}
+                  />
+                  <span className="prev" style={{ background: validHex ? hex : color }} />
+                </div>
+              </div>
+            )}
+          </div>
+        </AnchoredPopover>
+      )}
+    </>
+  );
+}
diff --git a/cur3/app/src/components/sensor/SensorLabel.tsx b/cur3/app/src/components/sensor/SensorLabel.tsx
new file mode 100644
index 0000000..59aa0e0
--- /dev/null
+++ b/cur3/app/src/components/sensor/SensorLabel.tsx
@@ -0,0 +1,130 @@
+import type { CSSProperties } from 'react';
+import type { SensorMetadata } from '../../types';
+
+/**
+ * MOCKUP (customer item 3, 2026-10-08): ONE sensor label standard (DESIGN_SYSTEM §4).
+ * Stacked = description + unit chip / tag below. Inline = description then tag (no brackets).
+ * Description first, tag second; no description -> the tag takes line 1 in mono.
+ *
+ * Mockup shortcut: a module-level registry fed by every `useSensorMetaMap` call and by the
+ * special-sensor recipes, so any component can resolve a tag. An implementation would pass the
+ * metadata in (the components below already accept an explicit `info`).
+ */
+export interface SensorInfo {
+  tag: string;
+  description?: string;
+  unit?: string;
+  component?: string;
+  /** Special sensor badge: 'f' = formula (ƒ), 's' = aggregate / operation (Σ). */
+  special?: 'f' | 's';
+}
+
+const REG = new Map<string, SensorInfo>();
+const key = (t: string) => t.trim().toLowerCase();
+
+export function registerSensorMeta(list: SensorMetadata[] | null | undefined) {
+  if (!list) return;
+  for (const m of list) {
+    const prev = REG.get(key(m.tag));
+    REG.set(key(m.tag), { ...prev, tag: m.tag, description: m.description || undefined, unit: m.unit || undefined, component: m.component || undefined });
+  }
+}
+export function registerSpecialSensors(list: { tag: string; kind?: string; config?: { mode?: string } }[] | null | undefined) {
+  if (!list) return;
+  for (const r of list) {
+    const prev = REG.get(key(r.tag)) ?? { tag: r.tag };
+    REG.set(key(r.tag), { ...prev, special: r.kind === 'formula' ? 'f' : 's' });
+  }
+}
+export function sensorInfo(tag: string): SensorInfo {
+  return REG.get(key(tag)) ?? { tag };
+}
+/** "DESCRIPTION · TAG · UNIT · Component" — the title on every truncating label. */
+export function sensorTitle(tag: string, info?: SensorInfo): string {
+  const i = info ?? sensorInfo(tag);
+  return [i.description, i.tag, i.unit, i.component].filter(Boolean).join(' · ');
+}
+/** Search haystack: description, tag, unit and component. */
+export function sensorHaystack(tag: string): string {
+  const i = sensorInfo(tag);
+  return `${i.description ?? ''} ${i.tag} ${i.unit ?? ''} ${i.component ?? ''}`.toLowerCase();
+}
+/** Plain-text inline label ("DESCRIPTION TAG") for canvas / attribute contexts. */
+export function sensorText(tag: string): string {
+  const i = sensorInfo(tag);
+  return i.description ? `${i.description} · ${i.tag}` : i.tag;
+}
+
+const NF = new Intl.NumberFormat('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 3 });
+const NF3 = new Intl.NumberFormat('en-US', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
+/** One en-US formatter, keeps 3 decimals (review ruling 5). Never for <input> values or CSV. */
+export function fmtNum(v: number | null | undefined, fixed3 = false): string {
+  if (v == null || !Number.isFinite(v)) return '–';
+  return (fixed3 ? NF3 : NF).format(v);
+}
+
+function FxBadge({ special }: { special?: 'f' | 's' }) {
+  if (!special) return null;
+  return <span className={`sl-fx ${special}`} aria-hidden="true">{special === 'f' ? 'ƒ' : 'Σ'}</span>;
+}
+
+interface LabelProps {
+  tag: string;
+  info?: SensorInfo;
+  /** Hide the unit chip (inline never shows it; stacked shows it unless false). */
+  unit?: boolean;
+  /** 'lg' = Workbench detail header size. */
+  size?: 'sm' | 'md' | 'lg';
+  /** Muted colours (chart subtitles). */
+  muted?: boolean;
+  /** Trigger / row context: hides the tag below ~150 px of label width. */
+  fit?: boolean;
+  className?: string;
+  style?: CSSProperties;
+  /** Extra element after the tag on line 2 (stacked) — e.g. a component chip. */
+  after?: React.ReactNode;
+}
+
+export function SensorLabel({ tag, info, unit = true, size = 'md', muted, className = '', style, after }: LabelProps) {
+  const i = info ?? sensorInfo(tag);
+  const title = sensorTitle(tag, i);
+  return (
+    <span className={`sl sl--${size}${muted ? ' sl--muted' : ''}${i.description ? '' : ' sl--notag'} ${className}`} title={title} style={style}>
+      <span className="sl-l1">
+        <FxBadge special={i.special} />
+        <span className="sl-desc">{i.description || i.tag}</span>
+        {unit && i.unit && <span className="unit-badge sl-unit">{i.unit}</span>}
+      </span>
+      {(i.description || after) && (
+        <span className="sl-l2">
+          {i.description && <span className="sl-tag">{i.tag}</span>}
+          {after}
+        </span>
+      )}
+    </span>
+  );
+}
+
+export function SensorInline({ tag, info, size = 'md', muted, fit, className = '', style }: LabelProps) {
+  const i = info ?? sensorInfo(tag);
+  const inner = (
+    <span className={`sl-inline sl--${size}${muted ? ' sl--muted' : ''}${i.description ? '' : ' sl--notag'}`}>
+      <FxBadge special={i.special} />
+      <span className="sl-desc">{i.description || i.tag}</span>
+      {i.description && <span className="sl-tag">{i.tag}</span>}
+    </span>
+  );
+  return (
+    <span className={`${fit ? 'sl-fit ' : ''}sl-inline-wrap ${className}`} title={sensorTitle(tag, i)} style={style}>{inner}</span>
+  );
+}
+
+/** HTML string version for ECharts tooltips (HTML formatter). */
+export function sensorInlineHtml(tag: string, color?: string, valueText?: string): string {
+  const i = sensorInfo(tag);
+  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
+  const label = i.description
+    ? `<span class="tt-desc">${esc(i.description)}</span><span class="tt-tag">${esc(i.tag)}</span>`
+    : `<span class="tt-desc tt-mono">${esc(i.tag)}</span>`;
+  return `<div class="tt-row">${color ? `<i class="tt-sw" style="background:${color}"></i>` : ''}<span class="tt-label">${label}</span>${valueText != null ? `<span class="tt-val"${color ? ` style="color:${color}"` : ''}>${esc(valueText)}</span>` : ''}</div>`;
+}
diff --git a/cur3/app/src/components/sensor/SensorPicker.tsx b/cur3/app/src/components/sensor/SensorPicker.tsx
new file mode 100644
index 0000000..2f4317a
--- /dev/null
+++ b/cur3/app/src/components/sensor/SensorPicker.tsx
@@ -0,0 +1,303 @@
+import { useEffect, useId, useMemo, useRef, useState, type ReactNode } from 'react';
+import { Check, ChevronDown, ChevronRight, Lock, Plus, Search, X } from 'lucide-react';
+import AnchoredPopover, { type PopoverAnchorRect } from '../AnchoredPopover';
+import Portal from '../Portal';
+import { SensorInline, sensorHaystack, sensorInfo, sensorTitle } from './SensorLabel';
+
+/**
+ * MOCKUP (customer item 3, 2026-10-08): ONE sensor picker (DESIGN_SYSTEM §4 "Sensor picking").
+ * Single = select-like trigger + anchored popover, one click picks and closes, no OK.
+ * Multi  = chips with × + dashed "Add…" button opening a modal with checkboxes; nothing changes until OK.
+ */
+
+const UNCAT = 'Uncategorized';
+type Row = { type: 'group'; comp: string; count: number; on: number; open: boolean } | { type: 'item'; tag: string } | { type: 'none' };
+
+function useGroupedRows(sensors: string[], query: string, expanded: Set<string>, isOn: (t: string) => boolean, noneRow: boolean, getComponent?: (t: string) => string) {
+  return useMemo(() => {
+    const q = query.trim().toLowerCase();
+    const list = q ? sensors.filter(s => sensorHaystack(s).includes(q)) : sensors;
+    const map = new Map<string, string[]>();
+    for (const s of list) {
+      const c = (getComponent ? getComponent(s) : sensorInfo(s).component) || UNCAT;
+      if (!map.has(c)) map.set(c, []);
+      map.get(c)!.push(s);
+    }
+    const groups = [...map.entries()].sort(([a], [b]) => (a === UNCAT ? 1 : b === UNCAT ? -1 : a.localeCompare(b)));
+    const rows: Row[] = [];
+    if (noneRow && !q) rows.push({ type: 'none' });
+    const flat = groups.length === 1 && groups[0][0] === UNCAT;
+    for (const [comp, tags] of groups) {
+      const open = flat || !!q || expanded.has(comp);
+      if (!flat) rows.push({ type: 'group', comp, count: tags.length, on: tags.filter(isOn).length, open });
+      if (open) for (const t of tags) rows.push({ type: 'item', tag: t });
+    }
+    return { rows, empty: list.length === 0 };
+  }, [sensors, query, expanded, isOn, noneRow, getComponent]);
+}
+
+function initials(c: string) {
+  const w = c.split(/\s+/).filter(Boolean);
+  return ((w[0]?.[0] ?? '') + (w[1]?.[0] ?? w[0]?.[1] ?? '')).toUpperCase();
+}
+
+/** The searchable, grouped, keyboard-driven list shared by the popover and the modal. */
+export function PickerList({ sensors, query, setQuery, isOn, onPick, noneRow, scope, multi, onEscape, getComponent, placeholder = 'Search description, tag, unit or component…' }: {
+  sensors: string[]; query: string; setQuery: (q: string) => void; isOn: (t: string) => boolean;
+  onPick: (tag: string | '') => void; noneRow?: boolean; scope?: ReactNode; multi?: boolean; onEscape: () => void;
+  getComponent?: (t: string) => string; placeholder?: string;
+}) {
+  const [expanded, setExpanded] = useState<Set<string>>(() => {
+    // Open the group of the current value(s) so it is visible.
+    const s = new Set<string>();
+    for (const t of sensors) if (isOn(t) || sensors.length <= 10) s.add((getComponent ? getComponent(t) : sensorInfo(t).component) || UNCAT);
+    return s;
+  });
+  const { rows, empty } = useGroupedRows(sensors, query, expanded, isOn, !!noneRow, getComponent);
+  const [active, setActive] = useState(-1);
+  const listRef = useRef<HTMLDivElement>(null);
+  const baseId = useId();
+  useEffect(() => { setActive(-1); }, [query]);
+  useEffect(() => {
+    if (active < 0) return;
+    listRef.current?.querySelector(`[data-ix="${active}"]`)?.scrollIntoView({ block: 'nearest' });
+  }, [active]);
+  const toggle = (c: string, open?: boolean) => setExpanded(prev => {
+    const n = new Set(prev);
+    const want = open ?? !n.has(c);
+    if (want) n.add(c); else n.delete(c);
+    return n;
+  });
+  const act = (r: Row | undefined) => {
+    if (!r) return;
+    if (r.type === 'group') toggle(r.comp);
+    else if (r.type === 'none') onPick('');
+    else onPick(r.tag);
+  };
+  const onKey = (e: React.KeyboardEvent) => {
+    if (e.key === 'ArrowDown') { e.preventDefault(); setActive(a => Math.min(rows.length - 1, a + 1)); }
+    else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(a => Math.max(-1, a - 1)); }
+    else if (e.key === 'ArrowRight' && rows[active]?.type === 'group') { e.preventDefault(); toggle((rows[active] as { comp: string }).comp, true); }
+    else if (e.key === 'ArrowLeft' && rows[active]?.type === 'group') { e.preventDefault(); toggle((rows[active] as { comp: string }).comp, false); }
+    else if (e.key === 'Enter') { e.preventDefault(); act(rows[active] ?? (rows.length === 1 || (query && rows.filter(r => r.type === 'item').length === 1) ? rows.find(r => r.type === 'item') : undefined)); }
+    else if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); onEscape(); }
+  };
+  return (
+    <>
+      <div className="pk-search">
+        <Search size={13} />
+        <input
+          autoFocus
+          role="combobox"
+          aria-expanded="true"
+          aria-controls={`${baseId}-list`}
+          aria-activedescendant={active >= 0 ? `${baseId}-r${active}` : undefined}
+          value={query}
+          placeholder={placeholder}
+          onChange={e => setQuery(e.target.value)}
+          onKeyDown={onKey}
+        />
+      </div>
+      {scope && <div className="pk-scope">{scope}</div>}
+      <div className="pk-list" id={`${baseId}-list`} role="listbox" aria-multiselectable={multi || undefined} ref={listRef}>
+        {empty && <div className="pk-empty">No sensor matches "{query}"<small>Search looks at description, tag, unit and component.</small></div>}
+        {rows.map((r, ix) => {
+          const kb = ix === active;
+          const id = `${baseId}-r${ix}`;
+          if (r.type === 'group') return (
+            <button key={`g-${r.comp}`} id={id} data-ix={ix} type="button" className={`pk-g${kb ? ' kb' : ''}`} aria-expanded={r.open} onClick={() => toggle(r.comp)} tabIndex={-1}>
+              <ChevronRight size={12} className="car" />
+              <span className="pk-b2">{initials(r.comp)}</span>
+              <span className="pk-gname">{r.comp}</span>
+              <span className={`n${r.on ? ' on' : ''}`}>{r.on ? `${r.on} / ${r.count}` : r.count}</span>
+            </button>
+          );
+          if (r.type === 'none') return (
+            <button key="none" id={id} data-ix={ix} type="button" role="option" aria-selected={isOn('')} className={`pk-item none-row${kb ? ' kb' : ''}${isOn('') ? ' on' : ''}`} onClick={() => onPick('')} tabIndex={-1}>
+              <span className="mark">{isOn('') && <Check size={12} />}</span>None
+            </button>
+          );
+          const on = isOn(r.tag);
+          const i = sensorInfo(r.tag);
+          return (
+            <button key={r.tag} id={id} data-ix={ix} type="button" role="option" aria-selected={on} className={`pk-item${kb ? ' kb' : ''}${on ? ' on' : ''}`} onClick={() => onPick(r.tag)} tabIndex={-1} title={sensorTitle(r.tag)}>
+              {multi ? <span className="cbx">{on && <Check size={10} strokeWidth={3} />}</span> : <span className="mark">{on && <Check size={12} />}</span>}
+              <SensorInline tag={r.tag} fit />
+              {i.unit && <span className="unit-badge pk-unit">{i.unit}</span>}
+            </button>
+          );
+        })}
+      </div>
+    </>
+  );
+}
+
+export interface SensorPickerSingleProps {
+  sensors: string[];
+  value: string;
+  onSelect: (tag: string) => void;
+  allowNone?: boolean;
+  placeholder?: string;
+  /** Required-and-empty -> dashed amber trigger. */
+  required?: boolean;
+  disabled?: boolean;
+  /** Shown as the placeholder (and tooltip) when disabled with no value. */
+  disabledReason?: string;
+  /** 24 px trigger for chart toolbars. */
+  compact?: boolean;
+  /** Line under the search box saying which list this is ("Sensors on the chart · 4"). */
+  scope?: ReactNode;
+  /** Popover right-aligned to the trigger (stays inside a chart). */
+  alignRight?: boolean;
+  /** Solid amber "warn" border (filter whose sensor left the chart). */
+  warn?: boolean;
+  getComponent?: (t: string) => string;
+  ariaLabel?: string;
+  className?: string;
+}
+
+export function SensorPickerSingle({ sensors, value, onSelect, allowNone, placeholder = 'Pick a sensor…', required, disabled, disabledReason, compact, scope, alignRight, warn, getComponent, ariaLabel, className = '' }: SensorPickerSingleProps) {
+  const [rect, setRect] = useState<PopoverAnchorRect | null>(null);
+  const [query, setQuery] = useState('');
+  const trig = useRef<HTMLButtonElement>(null);
+  const popRef = useRef<HTMLDivElement>(null);
+  const open = () => {
+    if (disabled || !trig.current) return;
+    const r = trig.current.getBoundingClientRect();
+    setQuery('');
+    setRect({ top: r.top, bottom: r.bottom, left: r.left, right: r.right });
+  };
+  const close = (focus = true) => { setRect(null); if (focus) requestAnimationFrame(() => trig.current?.focus()); };
+  useEffect(() => {
+    if (!rect) return;
+    const onDown = (e: MouseEvent) => {
+      const t = e.target as Node;
+      if (trig.current?.contains(t)) return;
+      if ((t as Element).closest?.('.pk-pop')) return;
+      close(false);
+    };
+    document.addEventListener('mousedown', onDown, true);
+    return () => document.removeEventListener('mousedown', onDown, true);
+  }, [rect]);
+  const W = Math.min(420, Math.round(window.innerWidth * 0.92));
+  const empty = !value;
+  return (
+    <>
+      <button
+        ref={trig}
+        type="button"
+        className={`pk-trigger${compact ? ' pk-trigger--sm' : ''}${required && empty && !disabled ? ' req' : ''}${warn ? ' warn' : ''} ${className}`}
+        aria-haspopup="listbox"
+        aria-expanded={!!rect}
+        aria-label={ariaLabel}
+        disabled={disabled}
+        title={disabled && disabledReason ? disabledReason : value ? sensorTitle(value) : undefined}
+        onClick={() => (rect ? close() : open())}
+        onKeyDown={e => { if ((e.key === 'ArrowDown' || e.key === ' ') && !rect) { e.preventDefault(); open(); } }}
+      >
+        {value ? <SensorInline tag={value} fit /> : <span className={`ph${allowNone && !required && !disabled && placeholder === 'None' ? ' none' : ''}`}>{disabled && disabledReason ? disabledReason : placeholder}</span>}
+        <ChevronDown size={compact ? 12 : 14} className="chev" />
+      </button>
+      {rect && (
+        <AnchoredPopover anchorRect={rect} onRequestClose={() => close(false)} width={alignRight ? W : undefined} style={{ width: W, padding: 0, maxHeight: 'none', overflow: 'visible' }}>
+          <div className="pk-pop" ref={popRef} role="dialog" aria-label={ariaLabel ?? 'Pick a sensor'}>
+            <PickerList
+              sensors={sensors}
+              query={query}
+              setQuery={setQuery}
+              isOn={(t) => t === value}
+              onPick={(t) => { onSelect(t); close(); }}
+              noneRow={allowNone}
+              scope={scope}
+              onEscape={() => close()}
+              getComponent={getComponent}
+            />
+          </div>
+        </AnchoredPopover>
+      )}
+    </>
+  );
+}
+
+export interface SensorPickerMultiProps {
+  sensors: string[];
+  selected: string[];
+  onConfirm: (tags: string[]) => void;
+  /** Modal title noun, e.g. "predictor sensors". */
+  noun: string;
+  /** Required scope line when the list isn't "all sensors" (review ruling 4). */
+  scope?: ReactNode;
+  required?: boolean;
+  /** Locked: chips without ×, Add… disabled with the reason. */
+  lockedReason?: string;
+  /** Chip decorations (e.g. ★ starting value) and click (pick the starting value). */
+  chipBase?: string;
+  onChipClick?: (tag: string) => void;
+  addLabel?: string;
+  getComponent?: (t: string) => string;
+  /** Render no chips (caller renders its own). */
+  hideChips?: boolean;
+}
+
+export function SensorPickerMulti({ sensors, selected, onConfirm, noun, scope, required, lockedReason, chipBase, onChipClick, addLabel, getComponent, hideChips }: SensorPickerMultiProps) {
+  const [open, setOpen] = useState(false);
+  const [pending, setPending] = useState<string[]>(selected);
+  const [query, setQuery] = useState('');
+  const addRef = useRef<HTMLButtonElement>(null);
+  const start = () => { if (lockedReason) return; setPending(selected); setQuery(''); setOpen(true); };
+  const close = () => { setOpen(false); requestAnimationFrame(() => addRef.current?.focus()); };
+  const pendingSet = useMemo(() => new Set(pending), [pending]);
+  return (
+    <div className="pk-multi">
+      {!hideChips && selected.map(t => (
+        <span key={t} className={`pk-chip${chipBase === t ? ' base' : ''}${onChipClick ? ' clickable' : ''}`} onClick={onChipClick ? () => onChipClick(t) : undefined} title={sensorTitle(t)}>
+          {chipBase === t && <span className="star">★</span>}
+          <SensorInline tag={t} />
+          {!lockedReason && (
+            <button type="button" className="x" aria-label={`Remove ${sensorInfo(t).description || t}`} onClick={(e) => { e.stopPropagation(); onConfirm(selected.filter(s => s !== t)); }}><X size={12} /></button>
+          )}
+        </span>
+      ))}
+      <button ref={addRef} type="button" className={`pk-add${required && !selected.length ? ' req' : ''}`} onClick={start} disabled={!!lockedReason} title={lockedReason}>
+        {lockedReason ? <Lock size={12} /> : <Plus size={12} />}
+        {lockedReason ? lockedReason : addLabel ?? (selected.length ? 'Add…' : `Add ${noun}…`)}
+      </button>
+      {open && (
+        <Portal>
+          <div className="pk-scrim" onMouseDown={close} role="presentation">
+            <div className="pk-modal" role="dialog" aria-modal="true" aria-label={`Select ${noun}`} onMouseDown={e => e.stopPropagation()}
+              onKeyDown={e => {
+                if (e.key === 'Escape') { e.preventDefault(); close(); }
+                if (e.key === 'Tab') {
+                  const f = [...(e.currentTarget.querySelectorAll<HTMLElement>('input,button:not([tabindex="-1"]):not(:disabled)'))];
+                  const i = f.indexOf(document.activeElement as HTMLElement);
+                  if (e.shiftKey && i <= 0) { e.preventDefault(); f[f.length - 1]?.focus(); }
+                  else if (!e.shiftKey && i === f.length - 1) { e.preventDefault(); f[0]?.focus(); }
+                }
+              }}>
+              <div className="pk-mh"><span>Select {noun}</span><button type="button" aria-label="Close" onClick={close}><X size={15} /></button></div>
+              <PickerList
+                sensors={sensors}
+                query={query}
+                setQuery={setQuery}
+                isOn={(t) => pendingSet.has(t)}
+                onPick={(t) => { if (!t) return; setPending(p => (p.includes(t) ? p.filter(x => x !== t) : [...p, t])); }}
+                scope={scope}
+                multi
+                onEscape={close}
+                getComponent={getComponent}
+              />
+              <div className="pk-foot">
+                <span className="cnt">{pending.length} selected</span>
+                <span style={{ display: 'flex', gap: 8 }}>
+                  <button type="button" className="pk-btn" onClick={close}>Cancel</button>
+                  <button type="button" className="pk-btn pri" onClick={() => { onConfirm(pending); close(); }}><Check size={13} /> OK</button>
+                </span>
+              </div>
+            </div>
+          </div>
+        </Portal>
+      )}
+    </div>
+  );
+}
