+/** One rigid moving part of a machine. */
+export interface PartDef {
+  /** What it is, for tests and the spec (never shown in the UI). */
+  name: string;
+  /** `turn` = rotates about `axis` through `c`; `slide` = moves back and forth along `axis`. */
+  kind: 'turn' | 'slide';
+  axis: Axis;
+  /** A point on the shaft axis, in the normalised machine space (after fitting). */
+  c: Vec3;
+  /** Revolutions (turn) or strokes (slide) per second; the sign is the direction. */
+  rps: number;
+  /** Phase offset, radians. */
+  phase: number;
+  /** Stroke amplitude of a slide, in normalised units (0 for a turn). */
+  amp: number;
+}
+
+/**
