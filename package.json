{
  "name": "soothsayer-wizard",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:build:mac:arm64": "tauri build --target aarch64-apple-darwin",
    "tauri:build:mac:x64": "tauri build --target x86_64-apple-darwin",
    "tauri:build:win": "tauri build --target x86_64-pc-windows-msvc",
    "installer:mac:arm64": "bash scripts/build-installer-mac-arm64.sh",
    "installer:mac:x64": "bash scripts/build-installer-mac-x64.sh",
    "installer:win": "powershell -ExecutionPolicy Bypass -File scripts/build-installer-windows.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@types/d3-scale": "^4.0.9",
    "d3-scale": "^4.0.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.5",
    "lucide-react": "^0.555.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "regl-scatterplot": "^1.16.0",
    "split.js": "^1.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.0"
  }
}
