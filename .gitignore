# Tauri / Rust build artifacts
/src-tauri/target

# Python sidecar — venv, build outputs, and compiled artifacts
/src-tauri/python/.venv
/src-tauri/python/build
/src-tauri/python/**/__pycache__
/src-tauri/python/**/*.pyc

# Compiled sidecar binaries (generated by build_sidecar.sh — do NOT commit)
/src-tauri/bin/backend-*
/src-tauri/bin/backend.dist

# Nuitka build diagnostic (machine-local, regenerated on every failed build)
src-tauri/python/nuitka-crash-report.xml
