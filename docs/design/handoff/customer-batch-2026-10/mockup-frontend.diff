diff --git a/cur3/app/src/components/windows/workbench/TrainQueueParts.tsx b/cur3/app/src/components/windows/workbench/TrainQueueParts.tsx
new file mode 100644
index 0000000..22edf0f
--- /dev/null
+++ b/cur3/app/src/components/windows/workbench/TrainQueueParts.tsx
@@ -0,0 +1,305 @@
+import { useEffect, useRef, useState } from 'react';
+import { ChevronDown, Loader2, X } from 'lucide-react';
+import Portal from '../../Portal';
+import { SensorInline } from '../../sensor/SensorLabel';
+import type { ModelKind } from '../../../types';
+
+/**
+ * MOCKUP (customer items 8 + 9, 2026-10-08): Train sensor / Train all with a queue.
+ * Presentational parts; the queue itself lives in BuildModelWindow (it trains through the same
+ * executeTrain the old per-model button used, one model at a time).
+ */
+
+export type TrainState = { s: 'ready' } | { s: 'up'; why: string } | { s: 'cant'; why: string };
+export interface QModel { id: string; kind: ModelKind; tag: string; groupNos: number[]; state: TrainState; complete: boolean }
+export type QItemState = 'queued' | 'running' | 'done' | 'failed' | 'notstarted';
+export interface QItem { id: string; state: QItemState; error?: string }
+export interface Run {
+  state: 'running' | 'done' | 'stopped' | 'aborted';
+  items: QItem[];
+  i: number;
+  cancel?: boolean;
+  closing?: boolean;
+  skipped: string[];
+  source: 'sensor' | 'all';
+  abortMessage?: string;
+  finishedAt?: number;
+}
+
+export const KIND_NAME: Record<ModelKind, string> = { individual: 'Individual', relationship: 'Relation model', clustering: 'Clustering' };
+export const KIND_LETTER: Record<ModelKind, string> = { individual: 'I', relationship: 'R', clustering: 'C' };
+/** Rough run times shown to the user (R ≈ 15 s, I / C ≈ 1–2 s). */
+export const secsOf = (k: ModelKind) => (k === 'relationship' ? 15 : k === 'clustering' ? 2 : 1);
+export const fmtSecs = (s: number) => (s >= 60 ? `${Math.floor(s / 60)} min ${s % 60} s` : `${s} s`);
+export const runCounts = (r: Run) => ({
+  done: r.items.filter(x => x.state === 'done').length,
+  failed: r.items.filter(x => x.state === 'failed').length,
+  notStarted: r.items.filter(x => x.state === 'notstarted').length,
+  queued: r.items.filter(x => x.state === 'queued').length,
+});
+
+export function TrainAllBar({ counts, blockedReason, running, onOpen }: {
+  counts: { ready: number; up: number; cant: number };
+  blockedReason: string | null;
+  running: boolean;
+  onOpen: () => void;
+}) {
+  const disabled = running || counts.ready === 0 || !!blockedReason;
+  return (
+    <div className="tq-all">
+      <button type="button" className="tq-btn" disabled={disabled} onClick={onOpen}
+        title={blockedReason ?? (counts.ready === 0 ? 'Nothing is ready to train' : undefined)}>
+        {running ? <><Loader2 size={12} className="pm-spin" /> Training…</> : '▶ Train all'}
+      </button>
+      <div className="tq-all-sub">
+        <span><b>{counts.ready}</b> ready</span><span><b>{counts.up}</b> up to date</span><span><b>{counts.cant}</b> can't train</span>
+        {blockedReason ? <span className={`tq-full ${/out of date|changed/i.test(blockedReason) ? 'bad' : 'w'}`}>{blockedReason}</span>
+          : counts.ready === 0 && !running ? <span className="tq-full">Nothing is ready to train.</span> : null}
+      </div>
+    </div>
+  );
+}
+
+export function SensorTrainButton({ need, total, disabled, title, label, why, whyClass, menu }: {
+  need: number; total: number; disabled: boolean; title?: string; label: string; why: string; whyClass: '' | 'w' | 'bad';
+  menu: { label: string; small: string; disabled?: boolean; onClick: () => void }[];
+}) {
+  const [open, setOpen] = useState(false);
+  const wrap = useRef<HTMLDivElement>(null);
+  useEffect(() => {
+    if (!open) return;
+    const on = (e: MouseEvent) => { if (!wrap.current?.contains(e.target as Node)) setOpen(false); };
+    const key = (e: KeyboardEvent) => { if (e.key === 'Escape') setOpen(false); };
+    document.addEventListener('mousedown', on); document.addEventListener('keydown', key);
+    return () => { document.removeEventListener('mousedown', on); document.removeEventListener('keydown', key); };
+  }, [open]);
+  void need; void total;
+  return (
+    <div className="tq-sensortrain" ref={wrap}>
+      <div className="tq-split">
+        <button type="button" id="tq-train-sensor" className="tq-btn pri" disabled={disabled} title={title} onClick={menu[0]?.onClick && (() => menu[0].onClick())}>{label}</button>
+        <button type="button" className="tq-caret" aria-label="More train options" aria-haspopup="menu" aria-expanded={open} disabled={disabled && menu.slice(1).every(x => x.disabled)} onClick={() => setOpen(o => !o)}><ChevronDown size={13} /></button>
+        {open && (
+          <div className="tq-menu" role="menu">
+            {menu.slice(1).map(m => (
+              <button key={m.label} type="button" role="menuitem" disabled={m.disabled} onClick={() => { setOpen(false); m.onClick(); }}>
+                {m.label}<small>{m.small}</small>
+              </button>
+            ))}
+          </div>
+        )}
+      </div>
+      <div className={`tq-why ${whyClass}`}>{why}</div>
+    </div>
+  );
+}
+
+export function RunStrip({ run, models, onDetails, onCancel, onDismiss, onCloseWindow }: {
+  run: Run; models: Map<string, QModel>;
+  onDetails: () => void; onCancel: () => void; onDismiss: () => void; onCloseWindow: () => void;
+}) {
+  const c = runCounts(run);
+  const segs = (
+    <div className="tq-seg" aria-hidden="true">
+      {run.items.map((x, k) => {
+        const m = models.get(x.id);
+        const t = m ? `${k + 1}. ${m.tag} · ${KIND_NAME[m.kind]} — ${x.state === 'done' ? 'trained' : x.state === 'failed' ? 'failed' : x.state === 'running' ? 'training now' : x.state === 'notstarted' ? 'not started' : 'queued'}` : '';
+        return <i key={x.id} title={t} className={x.state === 'done' ? 'd' : x.state === 'failed' ? 'f' : x.state === 'running' ? 'c' : x.state === 'notstarted' ? 's' : ''} />;
+      })}
+    </div>
+  );
+  if (run.state === 'aborted') {
+    return (
+      <div className="tq-run aborted" role="alert" data-testid="train-run-strip">
+        <span className="tq-ico bad">■</span>
+        <div className="tq-l1"><b>Run stopped: the data changed</b><span className="tq-who wrap">{run.abortMessage} The {c.done} trained before the change are kept; {c.notStarted} not started.</span></div>
+        {segs}
+        <div className="tq-acts"><button type="button" className="tq-btn plain sm" onClick={onDetails}>Details</button><button type="button" className="tq-btn danger sm" onClick={onCloseWindow}>Close window</button></div>
+      </div>
+    );
+  }
+  if (run.state === 'running') {
+    const cur = run.items[run.i];
+    const m = cur ? models.get(cur.id) : undefined;
+    const left = run.items.slice(run.i).filter(x => x.state === 'queued' || x.state === 'running').reduce((a, x) => a + secsOf(models.get(x.id)?.kind ?? 'individual'), 0);
+    return (
+      <div className="tq-run" role="status" aria-live="polite" data-testid="train-run-strip">
+        <Loader2 size={14} className="pm-spin tq-ico" />
+        <div className="tq-l1">
+          <b>{run.closing ? 'Closing after this model…' : run.cancel ? 'Stopping after this model…' : `Training ${run.i + 1} of ${run.items.length}`}</b>
+          {m && <span className="tq-who"><SensorInline tag={m.tag} size="sm" /> · {KIND_NAME[m.kind]}</span>}
+          <span className="tq-eta">≈ {fmtSecs(left)} left</span>
+        </div>
+        {segs}
+        <div className="tq-acts"><button type="button" className="tq-btn plain sm" onClick={onDetails}>Details</button><button type="button" className="tq-btn danger sm" disabled={!!run.cancel} onClick={onCancel}>Cancel</button></div>
+      </div>
+    );
+  }
+  // Partial failures are amber; red only when nothing trained (review B3-10).
+  const cls = run.state === 'stopped' ? 'stopped' : c.failed && !c.done ? 'failed' : c.failed ? 'partial' : 'done';
+  return (
+    <div className={`tq-run ${cls}`} role="status" data-testid="train-run-strip">
+      <span className="tq-ico">{run.state === 'stopped' ? '■' : c.failed ? '⚠' : '✓'}</span>
+      <div className="tq-l1">
+        {run.state === 'stopped'
+          ? <span>Stopped · <b>{c.done}</b> trained · <b>{c.notStarted}</b> not started</span>
+          : <span>Done · <b>{c.done}</b> trained{c.failed ? <> · <b className="tq-red">{c.failed} failed</b></> : null}{run.skipped.length ? ` · ${run.skipped.length} skipped` : ''}</span>}
+        {c.done > 0 && <span className="tq-who">Trained models still need their health set points, then Mark complete.</span>}
+      </div>
+      {segs}
+      <div className="tq-acts"><button type="button" className="tq-btn plain sm" onClick={onDetails}>Details</button><button type="button" className="tq-btn plain sm" onClick={onDismiss}>Dismiss</button></div>
+    </div>
+  );
+}
+
+function Row({ m, st, act, err }: { m: QModel; st: { cls: string; text: string }; act?: React.ReactNode; err?: string }) {
+  return (
+    <div className={`tq-qrow ${st.cls}`}>
+      <span className={`f4-kb model-kind-icon--${m.kind}`}>{KIND_LETTER[m.kind]}</span>
+      <div style={{ minWidth: 0 }}><div className="tq-nm"><SensorInline tag={m.tag} /></div><div className="tq-sub">{KIND_NAME[m.kind]}{m.kind === 'relationship' ? ' · ≈ 15 s' : ''}</div></div>
+      <span className={`tq-st ${st.cls}`}>{st.text}</span>
+      <span className="tq-act">{act}</span>
+      {err && <div className="tq-err">{err}</div>}
+    </div>
+  );
+}
+
+export function TrainAllModal({ phase, run, models, groups, includeUp, setIncludeUp, onClose, onStart, onCancelRun, onFix, onOpenModel, onRetry, onTrainNotStarted, onRemoveFromRun }: {
+  phase: 'preflight' | 'running' | 'done';
+  run: Run | null;
+  models: QModel[];
+  groups: { no: number; name: string; color: string }[];
+  includeUp: boolean; setIncludeUp: (v: boolean) => void;
+  onClose: () => void; onStart: (ids: string[], skipped: string[]) => void; onCancelRun: () => void;
+  onFix: (id: string) => void; onOpenModel: (id: string) => void; onRetry: (id: string) => void; onTrainNotStarted: () => void;
+  onRemoveFromRun: (id: string) => void;
+}) {
+  const byGroup = (fn: (m: QModel) => React.ReactNode) => groups.map(g => {
+    const ms = models.filter(m => m.groupNos.includes(g.no));
+    if (!ms.length) return null;
+    return (
+      <div key={g.no} className="tq-grp">
+        <div className="tq-grpt"><i style={{ background: g.color }} />{g.no === 0 ? 'Not in Group' : `FG-${g.no} · ${g.name}`}</div>
+        {ms.map(fn)}
+      </div>
+    );
+  });
+  // Each model once, in its first group.
+  const seen = new Set<string>();
+  const once = (fn: (m: QModel) => React.ReactNode) => (m: QModel) => { if (seen.has(m.id)) return null; seen.add(m.id); return <div key={m.id}>{fn(m)}</div>; };
+  let body: React.ReactNode, head: React.ReactNode, foot: React.ReactNode;
+  if (phase === 'preflight') {
+    const ready = models.filter(m => m.state.s === 'ready');
+    const up = models.filter(m => m.state.s === 'up');
+    const cant = models.filter(m => m.state.s === 'cant');
+    const willRun = [...ready, ...(includeUp ? up : [])];
+    const completeUp = up.filter(m => m.complete).length;
+    head = <div>Train all models<small>Runs one model at a time, by sensor. You can keep working; models already trained are kept if you cancel.</small></div>;
+    body = (
+      <>
+        <div className="tq-sumrow"><span className="big"><b>{willRun.length}</b> will train</span><span>· ≈ {fmtSecs(willRun.reduce((a, m) => a + secsOf(m.kind), 0))}</span><span>· <b>{includeUp ? 0 : up.length}</b> up to date, skipped</span><span>· <b className="tq-amber">{cant.length}</b> can't train — fix, then run again</span></div>
+        {byGroup(once(m => {
+          const inRun = m.state.s === 'ready' || (includeUp && m.state.s === 'up');
+          return <Row m={m} st={inRun ? { cls: 'ready', text: m.state.s === 'up' ? 'Re-train' : 'Ready' } : m.state.s === 'up' ? { cls: 'up', text: (m.state as { why: string }).why } : { cls: 'cant', text: `Can't train — ${(m.state as { why: string }).why}` }}
+            act={m.state.s === 'cant' ? <button type="button" className="tq-link" onClick={() => onFix(m.id)}>Fix →</button> : undefined} />;
+        }))}
+        {up.length > 0 && (
+          <label className="tq-opt"><input type="checkbox" checked={includeUp} onChange={e => setIncludeUp(e.target.checked)} />
+            <span>Also re-train the <b>{up.length}</b> up-to-date model{up.length > 1 ? 's' : ''}.{completeUp ? <span className="tq-amber"> {completeUp} Complete model{completeUp > 1 ? 's' : ''} will become Incomplete and need Mark complete again.</span> : null}</span>
+          </label>
+        )}
+      </>
+    );
+    foot = (
+      <>
+        <span className={`tq-reason${willRun.length ? '' : ' w'}`}>{willRun.length ? `Trains ${willRun.length} model${willRun.length > 1 ? 's' : ''}; the ${cant.length} with missing settings stay as they are.` : 'Nothing is ready to train — fix the settings listed above first.'}</span>
+        <button type="button" className="tq-btn plain" onClick={onClose}>Cancel</button>
+        <button type="button" className="tq-btn pri" disabled={!willRun.length} onClick={() => onStart(willRun.map(m => m.id), cant.map(m => m.id))}>▶ Start · {willRun.length}</button>
+      </>
+    );
+  } else if (phase === 'running' && run) {
+    const byId = new Map(run.items.map(x => [x.id, x]));
+    head = <div>Training {Math.min(run.i + 1, run.items.length)} of {run.items.length}<small>{run.cancel ? 'Stopping after the current model.' : 'One model at a time. Cancel stops after the current model; nothing already trained is lost.'}</small></div>;
+    body = byGroup(once(m => {
+      const it = byId.get(m.id);
+      if (!it) return <Row m={m} st={m.state.s === 'cant' ? { cls: 'cant', text: `Skipped — ${m.state.why}` } : { cls: 'up', text: 'Skipped — up to date' }} />;
+      const st = it.state === 'done' ? { cls: 'done', text: '✓ Trained' } : it.state === 'failed' ? { cls: 'err', text: '✕ Failed' } : it.state === 'running' ? { cls: 'now', text: 'Training…' } : it.state === 'notstarted' ? { cls: 'up', text: 'Not started' } : { cls: 'up', text: 'Queued' };
+      return <Row m={m} st={st} err={it.error} act={it.state === 'queued' && !run.cancel ? <button type="button" className="tq-link" onClick={() => onRemoveFromRun(m.id)}>Remove from run</button> : undefined} />;
+    }));
+    foot = (
+      <>
+        <span className="tq-reason">Models train with the settings saved now; a Complete model that is re-trained becomes Incomplete.</span>
+        <button type="button" className="tq-btn danger" disabled={!!run.cancel} onClick={onCancelRun}>Cancel run</button>
+      </>
+    );
+  } else if (run) {
+    const byId = new Map(run.items.map(x => [x.id, x]));
+    const c = runCounts(run);
+    head = <div>{run.state === 'aborted' ? 'Run stopped: the data changed' : run.state === 'stopped' ? 'Run stopped' : 'Run finished'}<small><b>{c.done}</b> trained{c.failed ? <> · <b className="tq-red">{c.failed} failed</b></> : null}{c.notStarted ? ` · ${c.notStarted} not started` : ''}{run.skipped.length ? ` · ${run.skipped.length} skipped (missing settings)` : ''}</small></div>;
+    body = byGroup(once(m => {
+      const it = byId.get(m.id);
+      if (!it) {
+        // Grey for "up to date"; amber only for a missing setting (review B3-5).
+        return m.state.s === 'cant'
+          ? <Row m={m} st={{ cls: 'cant', text: `Skipped — ${m.state.why}` }} act={<button type="button" className="tq-link" onClick={() => onFix(m.id)}>Fix →</button>} />
+          : <Row m={m} st={{ cls: 'up', text: 'Skipped — up to date' }} />;
+      }
+      const st = it.state === 'done' ? { cls: 'done', text: '✓ Trained · set points needed' } : it.state === 'failed' ? { cls: 'err', text: '✕ Failed' } : { cls: 'up', text: 'Not started' };
+      const act = run.state === 'aborted' ? undefined : it.state === 'failed' ? <button type="button" className="tq-link" onClick={() => onRetry(m.id)}>Try again</button> : it.state === 'done' ? <button type="button" className="tq-link" onClick={() => onOpenModel(m.id)}>Open →</button> : undefined;
+      return <Row m={m} st={st} act={act} err={it.error} />;
+    }));
+    foot = (
+      <>
+        <span className="tq-reason">Trained models are not Complete yet: set the health set points on each one, then Mark complete.</span>
+        {c.notStarted > 0 && run.state !== 'aborted' && <button type="button" className="tq-btn" onClick={onTrainNotStarted}>▶ Train the {c.notStarted} not started</button>}
+        <button type="button" className="tq-btn plain" onClick={onClose}>Close</button>
+      </>
+    );
+  }
+  return (
+    <Portal>
+      <div className="tq-back" onMouseDown={onClose} role="presentation">
+        <div className="tq-modal" role="dialog" aria-modal="true" aria-label="Train all models" onMouseDown={e => e.stopPropagation()} onKeyDown={e => { if (e.key === 'Escape') onClose(); }}>
+          <div className="tq-mh">{head}<button type="button" className="tq-btn plain sm" onClick={onClose}>{phase === 'running' ? 'Hide' : <X size={14} />}</button></div>
+          <div className="tq-mb">{body}</div>
+          <div className="tq-mf">{foot}</div>
+        </div>
+      </div>
+    </Portal>
+  );
+}
+
+/** Close while a run is active: live numbers; becomes "Run finished — close?" if it ends meanwhile. */
+export function CloseRunDialog({ run, models, onKeep, onStopAndClose, onClose }: {
+  run: Run; models: Map<string, QModel>; onKeep: () => void; onStopAndClose: () => void; onClose: () => void;
+}) {
+  const keepRef = useRef<HTMLButtonElement>(null);
+  useEffect(() => { keepRef.current?.focus(); }, [run.state]);
+  const c = runCounts(run);
+  const cur = run.items[run.i];
+  const m = cur ? models.get(cur.id) : undefined;
+  const finished = run.state !== 'running';
+  return (
+    <Portal>
+      <div className="tq-back" role="presentation" onKeyDown={e => { if (e.key === 'Escape') onKeep(); }}>
+        <div className="tq-confirm" role="alertdialog" aria-labelledby="tq-ct" aria-live="polite">
+          {finished ? (
+            <>
+              <div className="tq-cb"><b className="t" id="tq-ct">Run finished — close?</b><span><b>{c.done}</b> trained{c.failed ? ` · ${c.failed} failed` : ''}{c.notStarted ? ` · ${c.notStarted} not started` : ''}. Trained models keep their results.</span></div>
+              <div className="tq-cf"><button type="button" ref={keepRef} className="tq-btn pri" onClick={onClose}>Close</button></div>
+            </>
+          ) : (
+            <>
+              <div className="tq-cb">
+                <b className="t" id="tq-ct">Training is still running</b>
+                <span>Training {run.i + 1} of {run.items.length}{m ? <>: <span className="tq-mono-who"><SensorInline tag={m.tag} size="sm" /> · {KIND_NAME[m.kind]}</span></> : null}{m?.kind === 'relationship' ? ' · up to about 15 s on this model' : ''}.</span>
+                <span>Closing stops the run <b>after this model</b>; a model in training is never cut off half-way. The {c.done + 1} trained by then are kept. The {c.queued} not started stay as they are and can be trained next time.</span>
+              </div>
+              <div className="tq-cf"><button type="button" className="tq-btn danger left" onClick={onStopAndClose}>Stop after this model and close</button><button type="button" ref={keepRef} className="tq-btn pri" onClick={onKeep}>Keep training</button></div>
+            </>
+          )}
+        </div>
+      </div>
+    </Portal>
+  );
+}
