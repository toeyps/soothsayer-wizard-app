+type Agg = { fn: 'mean' | 'median'; src: string[] } | null;
+
+/** A recipe -> editor state (Edit in Manage). A legacy Sum operation opens as A + B + C. */
+export function recipeToState(r: SpecialSensorRecipe): { text: string; agg: Agg; round: Round; note: string | null } {
+  if (r.kind === 'operation') {
+    const ty = r.operationConfig.multiOp?.type ?? 'sum';
+    const dec = r.operationConfig.multiOp?.decimals;
+    if (r.operationConfig.mode === 'multi' && (ty === 'mean' || ty === 'median')) {
+      return { text: '', agg: { fn: ty, src: [...r.sourceSensors] }, round: dec != null ? { kind: 'dec', v: dec } : null, note: null };
+    }
+    if (r.operationConfig.mode === 'multi') {
+      return { text: r.sourceSensors.map(ref).join(' + '), agg: null, round: dec != null ? { kind: 'dec', v: dec } : null, note: 'Opened from a Sum recipe as A + B + C. Saving keeps the same result (a row is missing when any source is missing) and stores it as a formula.' };
