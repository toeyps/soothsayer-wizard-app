+.wb3-dh-ctl { align-items: flex-start; gap: 8px; }
+.wb3-actions { display: flex; align-items: center; gap: 8px; }
+.wb3-actions .rcx-btn, .wb3-actions .bmw-btn-ok, .wb3-actions .f4-btn-save { height: 32px; font-size: 12.5px; padding: 0 16px; border-radius: 8px; }
