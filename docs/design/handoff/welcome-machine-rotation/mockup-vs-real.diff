+ * unused): a 3×4 matrix per part. Allocates nothing — the renderer calls it
+ * once per frame per machine.
+ */
+export function poseParts(parts: ReadonlyArray<PartDef>, seconds: number, out: Float32Array): void {
+  for (let p = 0; p < parts.length; p++) {
+    const d = parts[p];
+    const o = (p + 1) * PART_STRIDE;
+    const a = seconds * d.rps * TAU + d.phase;
+    out.fill(0, o, o + PART_STRIDE);
+    out[o] = out[o + 5] = out[o + 10] = 1;
+    if (d.kind === 'slide') {
+      out[o + (d.axis === 'x' ? 3 : d.axis === 'y' ? 7 : 11)] = d.amp * Math.sin(a);
+      continue;
+    }
+    const c = Math.cos(a);
+    const s = Math.sin(a);
+    // u, v = the two axes the turn mixes (x: y,z · y: z,x · z: x,y)
+    const u = d.axis === 'x' ? 1 : d.axis === 'y' ? 2 : 0;
+    const v = (u + 1) % 3;
+    const cu = d.c[u];
+    const cv = d.c[v];
+    out[o + u * 4 + u] = c;
+    out[o + u * 4 + v] = -s;
+    out[o + u * 4 + 3] = cu - cu * c + cv * s;
+    out[o + v * 4 + u] = s;
+    out[o + v * 4 + v] = c;
+    out[o + v * 4 + 3] = cv - cu * s - cv * c;
+  }
