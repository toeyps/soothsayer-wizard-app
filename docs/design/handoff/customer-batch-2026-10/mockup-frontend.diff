diff --git a/cur3/app/src/components/upload/FailureGroupsStep.tsx b/cur3/app/src/components/upload/FailureGroupsStep.tsx
new file mode 100644
index 0000000..508be9d
--- /dev/null
+++ b/cur3/app/src/components/upload/FailureGroupsStep.tsx
@@ -0,0 +1,199 @@
+import { useEffect, useRef, useState } from 'react';
+import { X } from 'lucide-react';
+import { mono, type Tokens } from './uploadTheme';
+
+/** One failure group typed on setup step 3 (not yet saved; written into the
+ *  workspace's failureGroupState when the Dashboard opens). */
+export interface DraftGroup {
+  id: number;
+  name: string;
+  description: string;
+  recommendation: string;
+}
+
+/** Same palette (and order) as the Dashboard's group colours (FG_GROUP_PALETTE). */
+export const FG_STEP_COLORS = ['oklch(0.78 0.14 75)', 'oklch(0.7 0.15 310)', 'oklch(0.72 0.15 150)', 'oklch(0.68 0.17 245)'];
+
+interface Props {
+  T: Tokens;
+  projectName: string;
+  groups: DraftGroup[];
+  onChange: (groups: DraftGroup[]) => void;
+}
+
+const same = (a: string, b: string) => a.trim().toLowerCase() === b.trim().toLowerCase();
+
+/**
+ * MOCKUP (customer item 5, 2026-10-08): setup step 3 "Failure groups".
+ * Names the failure modes only; sensors are assigned later in the Dashboard.
+ */
+export default function FailureGroupsStep({ T, projectName, groups, onChange }: Props) {
+  const [quick, setQuick] = useState('');
+  const [live, setLive] = useState('');
+  const [newestId, setNewestId] = useState<number | null>(null);
+  const [undo, setUndo] = useState<{ g: DraftGroup; index: number } | null>(null);
+  useEffect(() => { if (!undo) return; const t = setTimeout(() => setUndo(null), 7000); return () => clearTimeout(t); }, [undo]);
+  const quickRef = useRef<HTMLInputElement>(null);
+  const listRef = useRef<HTMLDivElement>(null);
+  const dup = quick.trim() !== '' && groups.some(g => same(g.name, quick));
+  const canAdd = quick.trim() !== '' && !dup;
+
+  useEffect(() => { quickRef.current?.focus(); }, []);
+
+  const add = () => {
+    if (!canAdd) return;
+    const id = Math.max(0, ...groups.map(g => g.id)) + 1;
+    const name = quick.trim();
+    onChange([...groups, { id, name, description: '', recommendation: '' }]);
+    setNewestId(id);
+    setQuick('');
+    setLive(`Added ${name}. ${groups.length + 1} groups.`);
+    quickRef.current?.focus();
+  };
+
+  const remove = (id: number) => {
+    const i = groups.findIndex(g => g.id === id);
+    const name = groups[i]?.name;
+    const next = groups.filter(g => g.id !== id);
+    onChange(next);
+    setUndo({ g: groups[i], index: i });
+    setLive(`Removed ${name}.`);
+    requestAnimationFrame(() => {
+      const names = listRef.current?.querySelectorAll<HTMLInputElement>('.fgs-name');
+      const target = names?.[i] ?? names?.[i - 1];
+      (target ?? quickRef.current)?.focus();
+    });
+  };
+
+  const patch = (id: number, p: Partial<DraftGroup>) => onChange(groups.map(g => (g.id === id ? { ...g, ...p } : g)));
+
+  return (
+    <div data-testid="failure-groups-step" className="fgs">
+      <div style={{ fontFamily: mono, fontSize: 11, fontWeight: 500, letterSpacing: '0.12em', textTransform: 'uppercase', color: T.textFaint }}>
+        Step 3 of 3 · {projectName.trim()}
+      </div>
+      <h2 style={{ margin: '8px 0 0', fontSize: 28, fontWeight: 700, letterSpacing: '-0.025em', color: T.text }}>
+        Which failures should Wizard look for?
+      </h2>
+      <p style={{ margin: '8px 0 20px', maxWidth: '62ch', fontSize: 13.5, lineHeight: 1.5, color: T.textMuted }}>
+        A failure group is one way this machine can fail. Name each one now; you will pick the sensors that show it in the Dashboard, where you can see the data.
+      </p>
+
+      <div className="fgs-quick">
+        <input
+          ref={quickRef}
+          className={`fgs-in${dup ? ' bad' : ''}`}
+          value={quick}
+          placeholder="Failure group name, e.g. Bearing overheating (NDE)"
+          aria-label="New failure group name"
+          aria-invalid={dup}
+          onChange={e => setQuick(e.target.value)}
+          onKeyDown={e => {
+            if (e.key === 'Enter') { e.preventDefault(); add(); }
+            if (e.key === 'Escape') setQuick('');
+          }}
+        />
+        <button type="button" className="fgs-btn" disabled={!canAdd} tabIndex={canAdd ? 0 : -1} onClick={add}>+ Add group</button>
+      </div>
+      {dup ? (
+        <div className="fgs-hint err" role="alert">A failure group named "{quick.trim()}" already exists.</div>
+      ) : (
+        <div className="fgs-hint"><span className="fgs-kbd">Enter</span> adds the group and keeps the cursor here, so you can type the next one straight away.</div>
+      )}
+
+      {groups.length === 0 ? (
+        <div className="fgs-empty">
+          <b>No failure groups yet</b>
+          <p>Type the first failure mode above. Description and recommended action can be added on each group afterwards.</p>
+          <p className="ex">Bearing overheating · Lube oil pressure low · Cooling water loss</p>
+        </div>
+      ) : (
+        <div className="fgs-list" ref={listRef}>
+          {groups.map((g, i) => (
+            <GroupCard
+              key={g.id}
+              g={g}
+              index={i}
+              isNew={g.id === newestId}
+              dupName={(v) => groups.some(o => o.id !== g.id && same(o.name, v))}
+              onPatch={(p) => patch(g.id, p)}
+              onRemove={() => remove(g.id)}
+            />
+          ))}
+        </div>
+      )}
+      <div className="fgs-sr" aria-live="polite">{live}</div>
+      {undo && (
+        <div className="fgs-toast" role="status" aria-live="polite">
+          Removed <b>{undo.g.name}</b>
+          <button type="button" onClick={() => {
+            const next = groups.slice(); next.splice(Math.min(undo.index, next.length), 0, undo.g);
+            onChange(next); setLive(`Restored ${undo.g.name}.`); setUndo(null);
+          }}>Undo</button>
+        </div>
+      )}
+    </div>
+  );
+}
+
+function grow(t: HTMLTextAreaElement | null) {
+  if (!t) return;
+  t.style.height = 'auto';
+  t.style.height = `${Math.max(30, t.scrollHeight)}px`;
+}
+
+function GroupCard({ g, index, isNew, dupName, onPatch, onRemove }: {
+  g: DraftGroup; index: number; isNew: boolean;
+  dupName: (v: string) => boolean;
+  onPatch: (p: Partial<DraftGroup>) => void;
+  onRemove: () => void;
+}) {
+  const [name, setName] = useState(g.name);
+  const [err, setErr] = useState('');
+  const commit = () => {
+    const v = name.trim();
+    if (!v) { setName(g.name); setErr(''); return; }
+    if (dupName(v)) { setErr('Another group already has this name'); return; }
+    setErr('');
+    onPatch({ name: v });
+  };
+  return (
+    <div className={`fgs-card${isNew ? ' new' : ''}`}>
+      <span className="fgs-dot" style={{ background: FG_STEP_COLORS[index % FG_STEP_COLORS.length] }} />
+      <div style={{ minWidth: 0 }}>
+        <div className="fgs-nm">
+          <span className="fgs-no">FG-{index + 1}</span>
+          <input
+            className={`fgs-name${err ? ' bad' : ''}`}
+            value={name}
+            aria-label={`Name of FG-${index + 1}`}
+            aria-invalid={!!err}
+            title={err}
+            onChange={e => { setName(e.target.value); setErr(''); }}
+            onBlur={commit}
+            onKeyDown={e => {
+              if (e.key === 'Enter') { e.preventDefault(); (e.target as HTMLInputElement).blur(); }
+              if (e.key === 'Escape') { setName(g.name); setErr(''); }
+            }}
+          />
+        </div>
+        {err && <div className="fgs-hint err" style={{ margin: '2px 0 0' }} role="alert">{err}</div>}
+        <div className="fgs-flds">
+          <div className="fgs-fld">
+            <label htmlFor={`fgs-d${g.id}`}>Description</label>
+            <textarea id={`fgs-d${g.id}`} ref={grow} className="fgs-ta" rows={1} value={g.description}
+              placeholder="What failure mode does this group track?"
+              onChange={e => { grow(e.target); onPatch({ description: e.target.value }); }} />
+          </div>
+          <div className="fgs-fld">
+            <label htmlFor={`fgs-r${g.id}`}>Recommendation</label>
+            <textarea id={`fgs-r${g.id}`} ref={grow} className="fgs-ta" rows={1} value={g.recommendation}
+              placeholder="Recommended action when this failure is found"
+              onChange={e => { grow(e.target); onPatch({ recommendation: e.target.value }); }} />
+          </div>
+        </div>
+      </div>
+      <button type="button" className="fgs-x" title="Remove group" aria-label={`Remove ${g.name}`} onClick={onRemove}><X size={14} /></button>
+    </div>
+  );
+}
