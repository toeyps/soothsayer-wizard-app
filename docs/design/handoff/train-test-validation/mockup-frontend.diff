+    const hs = toMsLocal(h.start), he = toMsLocal(h.end);
+    if (hs === null || he === null) return periods;
+    const parts: TimePeriod[] = [];
+    if (hs - STEP >= ps) parts.push({ id: p.id, start: p.start, end: fmtLocal(hs - STEP) });
+    if (he + STEP <= pe) parts.push({ id: newPeriodId(), start: fmtLocal(he + STEP), end: p.end });
+    return sortPeriods([...periods.slice(0, i), ...parts, ...periods.slice(i + 1)]);
