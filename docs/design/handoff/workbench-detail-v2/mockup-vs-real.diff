+.wb3-ruler-band { position: relative; height: 12px; border-radius: 6px; margin: 4px 0 6px; box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08) inset; }
+.wb3-ruler-tick { position: absolute; top: -4px; bottom: -4px; width: 2px; margin-left: -1px; background: rgba(255, 255, 255, 0.55); border-radius: 1px; }
+.wb3-ruler-tick--user { background: #fff; width: 3px; margin-left: -1.5px; top: -6px; bottom: -6px; box-shadow: 0 0 0 2px var(--card-bg); }
+.wb3-ruler-tick--bad { background: var(--danger); }
+.wb3-ruler-names { height: 16px; }
+.wb3-ruler-nm { font-size: 10.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-secondary); }
+.wb3-ruler-nm--user { color: var(--text-primary); }
