+import type { ReactNode } from 'react';
+import type {
+    ClusteringHealthSetPoints,
+    HealthSetPoints,
+    IndividualHealthSetPoints,
+    RelationshipHealthSetPoints,
+} from '../../../types';
+import type { HealthIssue, HealthPreview } from '../../../types/health';
+import { canResetToMaster, resetToMaster, setPointSource, type SetPointSide } from '../../../utils/healthSetPoints';
+import { fmtNumExact } from '../../sensor/sensorInfo';
+import { fmtNum } from './chartTheme';
+import { fieldState, RING_QUICK, stepRing, type HealthVerdict } from './healthChecks';
+import { NumField } from './SetPointsCard';
+
+/*
+ * cur5 direction — the SCORE RULER replaces the "Health set points" table.
+ *
+ * One horizontal band reads value → score left to right. Each tick is a value
+ * on the sensor's scale and the score the model gives there; the band between
+ * two ticks is coloured by those scores (green 100, amber 80, red 0). The
+ * program's own ticks (±1SD, ±3SD, ±2RMSE, 1× / 3× SD) are plain mono text; the
+ * user's points are the ONLY inputs, big, in the same row, so "what do I type
+ * and where does it sit" is one picture:
+ *
+ *   Individual    0 ─── 80 ─── 100 ══ 100 ─── 80 ─── 0
+ *                 [L]   −3SD   −1SD     +1SD   +3SD   [H]
+ *   Relation      0 ─ 80 ─ 100 ═ 0 ═ 100 ─ 80 ─ 0     (residual = actual − predicted)
+ *                 [0⁻] [80⁻] −2RMSE  0  +2RMSE [80⁺] [0⁺]
+ *   Clustering    100 ═══ 80 ─── 0                     (one-sided: distance from the centre)
+ *                 1× SD   3× SD  [N× SD]
+ *
+ * Ticks are spaced EVENLY (a schematic, not a scale): the values under them say
+ * where each one really is. A missing user point greys its end; an invalid one
+ * turns its end red. The Checks (children) sit under the ruler in the same card.
+ */
+
+export interface ScoreRulerProps {
+    data: HealthPreview;
+    setPoints: HealthSetPoints;
+    unit: string;
+    issues: readonly HealthIssue[];
+    verdict: HealthVerdict | null;
+    onChange: (next: HealthSetPoints, commit?: boolean) => void;
+    onCommit: () => void;
+    /** The health score could not be loaded: nothing was checked. The user's ticks are
+     *  drawn as "not checked" (grey end, dashed tick, no score colour) — never as valid. */
+    unchecked?: boolean;
+    children?: ReactNode;
+}
+
+interface Tick {
+    score: number;
+    /** What the tick is ("−3SD", "L"). */
+    name: string;
+    /** Its value as text, or an input. */
+    value: ReactNode;
+    /** The user's own point. */
+    user?: boolean;
+    /** The user's point is missing / wrong. */
+    state?: 'required' | 'error' | 'unchecked' | null;
+    /** Narrow layout: a program tick's value, printed with its name. */
+    plain?: string;
+}
+
+/** Where a REJECTED typed value really sits on the ruler ("L = 62" between −3SD and
+ *  −1SD): the ruler keeps the model's order and marks the typed value in red at its
+ *  true place, so an impossible order is never drawn silently. `pos` is in tick units. */
+interface Ghost { pos: number; label: string; beyond?: 'left' | 'right' }
+
+/** A rejected value among the program's ticks AND the user's other valid points
+ *  (`anchors`: [value, tick index]): it never lands on the wrong side of one of them.
+ *  Past the last user tick it sits AT that end, with an arrow ("beyond"). */
+function ghostOf(v: number, label: string, anchors: [number, number][], n: number): Ghost {
+    const a = [...anchors].sort((x, y) => x[0] - y[0]);
+    const p = posAmong(v, a);
+    return p > n ? { pos: n, label: `${label} →`, beyond: 'right' } : p < 0 ? { pos: 0, label: `← ${label}`, beyond: 'left' } : { pos: p, label };
+}
+
+/** Labels that would overlap go on separate rows (row 0 = the top one). */
+function ghostRows(ghosts: Ghost[], n: number): { rows: number; rowOf: number[] } {
+    const order = ghosts.map((g, i) => i).sort((x, y) => ghosts[x].pos - ghosts[y].pos);
+    const last: number[] = [];
+    const rowOf: number[] = new Array(ghosts.length).fill(0);
+    for (const i of order) {
+        let r = last.findIndex(p => (ghosts[i].pos - p) / n >= 0.26);
+        if (r < 0) { r = last.length; last.push(ghosts[i].pos); } else last[r] = ghosts[i].pos;
+        rowOf[i] = r;
+    }
+    return { rows: Math.max(1, last.length), rowOf };
+}
+
+/** Position of `v` among anchors `[value, tick index]` (ascending by value): linear
+ *  between two anchors, half a tick outside the first / last one. */
+function posAmong(v: number, anchors: [number, number][]): number {
+    if (v < anchors[0][0]) return anchors[0][1] - 0.5;
+    for (let i = 1; i < anchors.length; i++) {
+        const [v0, p0] = anchors[i - 1];
+        const [v1, p1] = anchors[i];
+        if (v <= v1) return v1 === v0 ? p1 : p0 + ((v - v0) / (v1 - v0)) * (p1 - p0);
+    }
+    return anchors[anchors.length - 1][1] + 0.5;
+}
+
+const SCORE_RGB: Record<100 | 80 | 0, string> = { 100: '16, 185, 129', 80: '229, 169, 61', 0: '238, 90, 69' };
+const scoreRgb = (s: number) => SCORE_RGB[(s >= 100 ? 100 : s >= 80 ? 80 : 0) as 100 | 80 | 0];
+
+/** The band's background: one colour stop per tick, so each segment fades between its ends. */
+function gradient(ticks: Tick[]): string {
+    const n = ticks.length - 1;
+    const stops = ticks.map((t, i) => {
+        const missing = t.user && t.state;
+        const c = missing ? '120, 124, 140' : scoreRgb(t.score);
+        return `rgba(${c}, ${missing ? 0.35 : 0.85}) ${(i / n) * 100}%`;
+    });
+    return `linear-gradient(90deg, ${stops.join(', ')})`;
+}
+
+function Ruler({ ticks, testId, ghosts = [] }: { ticks: Tick[]; testId: string; ghosts?: Ghost[] }) {
+    const n = ticks.length - 1;
+    const { rows, rowOf } = ghostRows(ghosts, n);
+    return (
+        <div className={`wb3-ruler wb3-ruler--${ticks.length}${ghosts.length ? ' wb3-ruler--ghost' : ''}`} data-testid={testId} style={{ '--n': n } as React.CSSProperties}>
+            {ghosts.length > 0 && (
+                <div className="wb3-ruler-ghosts" data-testid="ruler-ghosts" style={{ height: rows * 22 }}>
+                    {ghosts.map((g, i) => (
+                        <span key={i} className={`wb3-ruler-ghost${g.beyond ? ` wb3-ruler-ghost--${g.beyond}` : ''}`} data-testid="ruler-ghost" data-row={rowOf[i]} style={{ left: `${(g.pos / n) * 100}%`, top: rowOf[i] * 22 }} title="Where the value you typed sits — it is not accepted there">{g.label}</span>
+                    ))}
+                </div>
+            )}
+            <div className="wb3-ruler-scores" aria-hidden="true">
+                {ticks.map((t, i) => (
+                    <span key={i} className={`wb3-ruler-sc wb3-ruler-sc--${t.score >= 100 ? 'ok' : t.score >= 80 ? 'warn' : 'bad'}${t.user && t.state ? ' wb3-ruler-sc--off' : ''}`} style={{ left: `${(i / n) * 100}%` }}>
+                        {t.score}
+                    </span>
+                ))}
+            </div>
+            <div className="wb3-ruler-band" style={{ background: gradient(ticks) }}>
+                {ticks.map((t, i) => (
+                    <i key={i} className={`wb3-ruler-tick${t.user ? ' wb3-ruler-tick--user' : ''}${t.state === 'error' ? ' wb3-ruler-tick--bad' : t.state === 'required' ? ' wb3-ruler-tick--req' : t.state === 'unchecked' ? ' wb3-ruler-tick--unk' : ''}`} style={{ left: `${(i / n) * 100}%` }} />
+                ))}
+                {ghosts.map((g, i) => (
+                    <i key={`g${i}`} className="wb3-ruler-gmark" aria-hidden="true" style={{ left: `${(g.pos / n) * 100}%`, top: -(26 + (rows - 1 - rowOf[i]) * 22) }} />
+                ))}
+            </div>
+            <div className="wb3-ruler-names">
+                {ticks.map((t, i) => (
+                    <span key={i} className={`wb3-ruler-nm${t.user ? ' wb3-ruler-nm--user' : ''}${t.state === 'error' ? ' wb3-ruler-nm--bad' : t.state === 'required' ? ' wb3-ruler-nm--req' : ''}`} style={{ left: `${(i / n) * 100}%` }}>{t.name}{t.plain && <small className="wb3-ruler-nm-pv">{t.plain}</small>}</span>
+                ))}
+            </div>
+            <div className="wb3-ruler-values">
+                {ticks.map((t, i) => (
+                    <span key={i} className={`wb3-ruler-v${t.user ? ' wb3-ruler-v--user' : ''}`} style={{ left: `${(i / n) * 100}%` }}>{t.user && <small className="wb3-ruler-vl" aria-hidden="true">{t.name}</small>}{t.value}</span>
+                ))}
+            </div>
+        </div>
+    );
+}
+
+const VERDICT_DOT: Record<HealthVerdict, { cls: 'complete' | 'need' | 'bad'; words: string }> = {
+    valid: { cls: 'complete', words: 'Set points valid' },
+    needs: { cls: 'need', words: 'Set points still empty' },
+    bad: { cls: 'bad', words: 'A set point is not valid' },
+};
+
+export default function ScoreRuler(props: ScoreRulerProps) {
+    const { data, setPoints, verdict, children } = props;
+    const dot = verdict ? VERDICT_DOT[verdict] : null;
+    const kindNote = data.stats.kind === 'individual'
+        ? 'Score 100 within ±1SD of the learned normal · 80 at ±3SD · 0 at L and H — you set L and H'
+        : data.stats.kind === 'relationship'
+            ? 'Residual = actual − predicted · 100 within ±2RMSE · you set where 80 and 0 sit on each side'
+            : 'Distance from each cluster\'s centre in SD units · 100 inside 1× SD · 80 at 3× SD · 0 at N× SD — you set N';
+    return (
+        <section className="hs-card wb3-rulercard" data-testid="set-points-card">
+            <div className="wb2-card-h">
+                <b>Health set points</b>
+                <span className="wb2-card-s">{kindNote}</span>
+                <span className="wb2-sp" />
+                {dot && <span className={`f4-sdot f4-sdot--${dot.cls}`} data-testid="hs-verdict" data-verdict={verdict ?? undefined} role="img" title={dot.words} aria-label={dot.words} />}
+            </div>
+            {data.stats.kind === 'individual' && setPoints.kind === 'individual' && <IndividualRuler {...props} sp={setPoints} />}
+            {data.stats.kind === 'relationship' && setPoints.kind === 'relationship' && <RelationshipRuler {...props} sp={setPoints} />}
+            {data.stats.kind === 'clustering' && setPoints.kind === 'clustering' && <ClusteringRuler {...props} sp={setPoints} />}
+            {children && <div className="hsx-checks" id="hs-checks">{children}</div>}
+        </section>
+    );
+}
+
+type P<S extends HealthSetPoints> = ScoreRulerProps & { sp: S };
+
+function IndividualRuler({ data, sp, unit, issues, onChange, onCommit, unchecked }: P<IndividualHealthSetPoints>) {
+    if (data.stats.kind !== 'individual') return null;
+    const st = data.stats;
+    const field = (s: SetPointSide) => (
+        <NumField
+            key={s}
+            testId={`sp-${s}`}
+            big
+            ariaLabel={s === 'lower' ? 'L — the value where the score reaches 0 on the low side' : 'H — the value where the score reaches 0 on the high side'}
+            hint={s === 'lower' ? 'L' : 'H'}
+            unit={unit}
+            value={s === 'lower' ? sp.lower : sp.upper}
+            state={fieldState(issues, s)}
+            describedBy={fieldState(issues, s) ? 'hs-checks' : undefined}
+            onChange={v => onChange({ ...sp, [s]: v })}
+            onCommit={onCommit}
+        />
+    );
+    const ticks: Tick[] = [
+        { score: 0, name: 'L', value: field('lower'), user: true, state: unchecked ? 'unchecked' : fieldState(issues, 'lower') },
+        { score: 80, name: '−3SD', value: fmtNum(st.boundary_3sd[0]) },
+        { score: 100, name: '−1SD', value: fmtNum(st.boundary_1sd[0]) },
+        { score: 100, name: '+1SD', value: fmtNum(st.boundary_1sd[1]) },
+        { score: 80, name: '+3SD', value: fmtNum(st.boundary_3sd[1]) },
+        { score: 0, name: 'H', value: field('upper'), user: true, state: unchecked ? 'unchecked' : fieldState(issues, 'upper') },
+    ];
+    const A: [number, number][] = [[st.boundary_3sd[0], 1], [st.boundary_1sd[0], 2], [st.boundary_1sd[1], 3], [st.boundary_3sd[1], 4]];
+    const ghosts: Ghost[] = [];
+    const fin = (v: number | null): v is number => typeof v === 'number' && Number.isFinite(v);
+    // The user's other point, when it is valid, is an anchor too (L = 90 with H = 85 sits BEYOND H).
+    if (ticks[0].state === null && fin(sp.lower)) A.push([sp.lower, 0]);
+    if (ticks[5].state === null && fin(sp.upper)) A.push([sp.upper, 5]);
+    if (ticks[0].state === 'error' && fin(sp.lower)) ghosts.push(ghostOf(sp.lower, `L = ${fmtNumExact(sp.lower).replace('-', '−')}`, A, 5));
+    if (ticks[5].state === 'error' && fin(sp.upper)) ghosts.push(ghostOf(sp.upper, `H = ${fmtNumExact(sp.upper).replace('-', '−')}`, A, 5));
+    const srcL = setPointSource(sp, 'lower');
+    const srcU = setPointSource(sp, 'upper');
+    const words = (letter: 'L' | 'H', src: ReturnType<typeof setPointSource>) =>
+        src === 'model' ? `${letter} is set on this model` : src === 'master' ? `${letter} comes from the master data` : `${letter} is not in the master data`;
+    const origin = srcL === 'master' && srcU === 'master' ? 'L and H come from the master data alarm limits.'
+        : srcL === 'not-in-master' && srcU === 'not-in-master' ? 'The master data has no alarm limits for this sensor — type L and H.'
+        : `${words('L', srcL)} · ${words('H', srcU)}.`;
+    const reset = (s: SetPointSide) => {
+        const master = s === 'lower' ? sp.masterLower : sp.masterUpper;
+        if (typeof master !== 'number' || !canResetToMaster(sp, s)) return null;
+        return (
+            <button key={s} type="button" className="hs-restore" data-testid={`sp-${s}-reset`} onClick={() => onChange(resetToMaster(sp, s), true)}>
+                Use master {s === 'lower' ? 'L' : 'H'} {fmtNumExact(master)}
+            </button>
+        );
+    };
+    const resets = [reset('lower'), reset('upper')].filter(Boolean);
+    return (
+        <>
+            <Ruler ticks={ticks} testId="hs-ladder" ghosts={ghosts} />
+            <div className="wb3-ruler-note" data-testid="master-note">
+                <span data-testid="master-origin" data-lower={srcL} data-upper={srcU}>{origin}</span>
+                {' '}Saved on this model only; the master data is not changed.
+                {resets.length > 0 && <>{' '}{resets[0]}{resets.length > 1 && <>{' · '}{resets[1]}</>}</>}
+            </div>
+        </>
+    );
+}
+
+function RelationshipRuler({ data, sp, unit, issues, onChange, onCommit, unchecked }: P<RelationshipHealthSetPoints>) {
+    if (data.stats.kind !== 'relationship') return null;
+    const w = data.stats.two_rmse;
+    const field = (key: keyof Omit<RelationshipHealthSetPoints, 'kind'>, wire: string, label: string) => (
+        <NumField
+            testId={`sp-${wire}`}
+            big
+            ariaLabel={label}
+            hint={wire.endsWith('_lower') ? '−' : '+'}
+            unit={unit}
+            value={sp[key]}
+            state={fieldState(issues, wire)}
+            describedBy={fieldState(issues, wire) ? 'hs-checks' : undefined}
+            onChange={v => onChange({ ...sp, [key]: v })}
+            onCommit={onCommit}
+        />
+    );
+    const st = (wire: string): Tick['state'] => (unchecked ? 'unchecked' : fieldState(issues, wire));
+    const ticks: Tick[] = [
+        { score: 0, name: '0 low', value: field('residualAt0Lower', 'residual_at_0_lower', '0 low — the residual where the score reaches 0 on the low side'), user: true, state: st('residual_at_0_lower') },
+        { score: 80, name: '80 low', value: field('residualAt80Lower', 'residual_at_80_lower', '80 low — the residual where the score is 80 on the low side'), user: true, state: st('residual_at_80_lower') },
+        { score: 100, name: '−2RMSE', value: `−${fmtNum(w)}`, plain: `−${fmtNum(w)}` },
+        { score: 100, name: 'no residual', value: '0' },
+        { score: 100, name: '+2RMSE', value: `+${fmtNum(w)}`, plain: `+${fmtNum(w)}` },
+        { score: 80, name: '80 high', value: field('residualAt80Upper', 'residual_at_80_upper', '80 high — the residual where the score is 80 on the high side'), user: true, state: st('residual_at_80_upper') },
+        { score: 0, name: '0 high', value: field('residualAt0Upper', 'residual_at_0_upper', '0 high — the residual where the score reaches 0 on the high side'), user: true, state: st('residual_at_0_upper') },
+    ];
+    // A rejected point is marked where it really sits among the band edges AND the
+    // user's other valid points (never on the wrong side of one of them).
+    const pts: [number, number | null, string][] = [[0, sp.residualAt0Lower, '0 low'], [1, sp.residualAt80Lower, '80 low'], [5, sp.residualAt80Upper, '80 high'], [6, sp.residualAt0Upper, '0 high']];
+    const fin = (v: number | null): v is number => typeof v === 'number' && Number.isFinite(v);
+    const RA: [number, number][] = [[-w, 2], [0, 3], [w, 4]];
+    pts.forEach(([i, v]) => { if (ticks[i].state === null && fin(v)) RA.push([v, i]); });
+    const ghosts: Ghost[] = [];
+    pts.forEach(([i, v, nm]) => {
+        if (ticks[i].state === 'error' && fin(v)) ghosts.push(ghostOf(v, `${nm} = ${fmtNumExact(v).replace('-', '−')}`, RA, 6));
+    });
+    return (
+        <>
+            <Ruler ticks={ticks} testId="hs-ladder" ghosts={ghosts} />
+            <div className="wb3-ruler-note" data-testid="sign-note">
+                The low points are negative, the high points positive. Each 0 point sits further from zero than its 80 point.
+            </div>
+        </>
+    );
+}
+
+function ClusteringRuler({ sp, issues, onChange, onCommit, unchecked }: P<ClusteringHealthSetPoints>) {
+    const state = fieldState(issues, 'outer_sd');
+    const set = (n: number | null, commit?: boolean) => onChange({ ...sp, outerSd: n }, commit);
+    const ticks: Tick[] = [
+        { score: 100, name: 'centre', value: '0× SD' },
+        { score: 100, name: '1× SD', value: '1×' },
+        { score: 80, name: '3× SD', value: '3×' },
+        {
+            score: 0, name: 'N× SD', user: true, state: unchecked ? 'unchecked' : state,
+            value: (
+                <span className="hs-kstep wb3-kstep" data-testid="ring-control">
+                    <button type="button" data-testid="ring-dec" aria-label="Smaller" onClick={() => set(stepRing(sp.outerSd, -1), true)}>−</button>
+                    <NumField wide big testId="sp-outer_sd" ariaLabel="Outer ring in × SD" unit="" suffix="× SD" hint="N" value={sp.outerSd} state={state} describedBy={state ? 'hs-checks' : undefined} onChange={v => set(v)} onCommit={onCommit} />
+                    <button type="button" data-testid="ring-inc" aria-label="Larger" onClick={() => set(stepRing(sp.outerSd, 1), true)}>+</button>
+                </span>
+            ),
+        },
+    ];
+    const ghosts: Ghost[] = state === 'error' && typeof sp.outerSd === 'number' && Number.isFinite(sp.outerSd)
+        ? [ghostOf(Math.max(0, sp.outerSd), `N = ${fmtNumExact(sp.outerSd).replace('-', '−')}×`, [[0, 0], [1, 1], [3, 2]], 3)]
+        : [];
+    return (
+        <>
+            <Ruler ticks={ticks} testId="hs-ladder" ghosts={ghosts} />
+            <div className="wb3-ruler-note">
+                <span className="hs-quick">
+                    {RING_QUICK.map(q => (
+                        <button key={q} type="button" data-testid={`ring-quick-${q}`} className={sp.outerSd === q ? 'on' : ''} aria-pressed={sp.outerSd === q} onClick={() => set(q, true)}>{q}×</button>
+                    ))}
+                </span>
+                {' '}One N for every cluster: each cluster gets its own 1×, 3× and N× rings, sized by its own SD.
+            </div>
+        </>
+    );
+}
