diff --git a/cur3/app/src/components/windows/SpecialSensorFormulaEditor.tsx b/cur3/app/src/components/windows/SpecialSensorFormulaEditor.tsx
new file mode 100644
index 0000000..1483105
--- /dev/null
+++ b/cur3/app/src/components/windows/SpecialSensorFormulaEditor.tsx
@@ -0,0 +1,957 @@
+import { forwardRef, useCallback, useEffect, useImperativeHandle, useLayoutEffect, useMemo, useRef, useState } from 'react';
+import { invoke } from '@tauri-apps/api/core';
+import { AlertTriangle, Check, ChevronDown, Lock, Search, X } from 'lucide-react';
+import AnchoredPopover, { type PopoverAnchorRect } from '../AnchoredPopover';
+import Portal from '../Portal';
+import { PickerList } from '../sensor/SensorPicker';
+import { SensorInline, SensorLabel, sensorHaystack, sensorInfo, sensorTitle } from '../sensor/SensorLabel';
+import type { SpecialSensorRecipe } from '../../types';
+
+/**
+ * MOCKUP (customer item 6, direction 2 — 2026-10-09, ui-design-lead): the special-sensor FORMULA
+ * EDITOR. One free-text field (the stored formula itself, $Tag / ${Tag with spaces}) with live
+ * structure painted behind the text: sensor references as tinted chips, functions, depth-coloured
+ * brackets with pair matching, the error range underlined. Editing is ordinary text editing —
+ * select, type, Ctrl+Z, cut/paste — plus: `(` with a selection wraps it, Wrap / Unwrap buttons,
+ * an autocomplete that opens at the caret for `$…` and names, and a small insert palette.
+ * Average / Median stay an aggregate block (user decision 2026-10-08).
+ * Engine rules: round(step, x) (Excel's round(x, n) is refused); ln = natural log, log = log10;
+ * min / max take any number of values; SI suffixes (5k); -A^2 = (−A)²; missing input → empty row.
+ */
+
+// ---------- tokens with char ranges ----------
+type Tok =
+  | { k: 'sens'; t: string; s: number; e: number }
+  | { k: 'num'; v: string; s: number; e: number }
+  | { k: 'op'; v: '+' | '-' | '*' | '/' | '^'; s: number; e: number }
+  | { k: 'br'; v: '(' | ')'; s: number; e: number; depth: number; pair: number }
+  | { k: 'comma'; s: number; e: number }
+  | { k: 'fn'; v: string; s: number; e: number }
+  | { k: 'bad'; v: string; s: number; e: number };
+
+export type CalcResult =
+  | { kind: 'empty' }
+  | { kind: 'formula'; formula: string; valid: boolean; issue: string | null }
+  | { kind: 'agg'; fn: 'mean' | 'median'; sources: string[]; decimals: number | null; valid: boolean; issue: string | null };
+
+export interface CalculatorHandle { insertSensor: (tag: string) => void; reset: () => void }
+
+const ENGINE_FNS_FALLBACK = ['abs', 'sqrt', 'pow', 'exp', 'ln', 'log', 'log10', 'round', 'min', 'max', 'ceil', 'floor', 'sin', 'cos', 'tan', 'asin', 'acos', 'atan', 'sinh', 'cosh', 'tanh', 'asinh', 'acosh', 'atanh', 'sign', 'int', 'pi', 'e'];
+const ARGS: Record<string, [number, number]> = { pow: [2, 2], round: [1, 2], min: [1, 999], max: [1, 999], pi: [0, 0], e: [0, 0] };
+const FN_HELP: Record<string, string> = {
+  abs: 'size of a value, sign removed', sqrt: 'square root', pow: 'pow(x, n) = x^n', exp: 'e^x', ln: 'natural log', log: 'log base 10', log10: 'log base 10',
+  round: 'round(x) whole number · round(0.01, x) to a step', min: 'smallest of the values', max: 'largest of the values', ceil: 'round up', floor: 'round down',
+  sin: 'sine (radians)', cos: 'cosine (radians)', tan: 'tangent (radians)', asin: 'arc sine', acos: 'arc cosine', atan: 'arc tangent',
+  sinh: 'hyperbolic sine', cosh: 'hyperbolic cosine', tanh: 'hyperbolic tangent', asinh: 'inverse sinh', acosh: 'inverse cosh', atanh: 'inverse tanh',
+  sign: '−1, 0 or 1', int: 'whole part, decimals cut', pi: 'π = 3.14159…', e: 'e = 2.71828…',
+};
+const PALETTE_FNS = ['abs', 'sqrt', 'ln', 'log', 'exp', 'round', 'min', 'max', 'ceil', 'floor'];
+const FN_LBL: Record<string, string> = { sqrt: '√', log: 'log₁₀' };
+const SYM: Record<string, string> = { '*': '×', '/': '÷', '-': '−', '+': '+', '^': '^' };
+const AGG_NAME = { mean: 'Average', median: 'Median' } as const;
+
+const ref = (t: string) => (/[^A-Za-z0-9_.]/.test(t) ? '${' + t + '}' : '$' + t);
+const stepOf = (dec: number) => (dec === 0 ? '1' : (10 ** -dec).toFixed(dec));
+type Round = null | { kind: 'dec'; v: number } | { kind: 'step'; v: number };
+function wrapRound(e: string, round: Round) {
+  if (round === null || !e) return e;
+  return `round(${round.kind === 'dec' ? stepOf(round.v) : String(round.v)}, ${e})`;
+}
+function balanced(s: string) { let d = 0; for (const c of s) { if (c === '(') d++; if (c === ')') { d--; if (d < 0) return false; } } return d === 0; }
+
+/** Text -> tokens (never throws; unreadable characters become `bad` tokens). */
+function tokenize(src: string): Tok[] {
+  const out: Tok[] = [];
+  const re = /\s*(?:\$\{([^}]*)\}|\$([\p{L}\p{N}_][\p{L}\p{N}_.]*)|(\d+\.?\d*(?:e[-+]?\d+)?[kMGTmunp]?|\.\d+)|([A-Za-z_][A-Za-z0-9_]*)|([+\-*/^(),])|(\S))/uy;
+  let m: RegExpExecArray | null;
+  re.lastIndex = 0;
+  const stack: number[] = [];
+  while (re.lastIndex < src.length && (m = re.exec(src))) {
+    const e = re.lastIndex, s = e - m[0].trimStart().length;
+    if (m[1] !== undefined || m[2]) {
+      const t = m[1] ?? m[2];
+      if (!t) out.push({ k: 'bad', v: '${}', s, e }); else out.push({ k: 'sens', t, s, e });
+    } else if (m[3]) out.push({ k: 'num', v: m[3], s, e });
+    else if (m[4]) out.push({ k: 'fn', v: m[4], s, e });
+    else if (m[5]) {
+      const c = m[5];
