+.wb3-markcol .tq-why { max-width: 260px; text-align: right; }
+.wb3-ruler-note { font-size: 11.5px; color: var(--text-secondary); line-height: 1.5; padding: 4px 0 10px; display: flex; flex-wrap: wrap; gap: 4px 6px; align-items: center; }
