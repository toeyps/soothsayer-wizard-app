+function splitStamp(label: string): string[] {
+    const m = /^(\d{4}\/\d{2}\/\d{2}) (\d{2}:\d{2}(?::\d{2})?)$/.exec(label);
+    return m ? [m[1], m[2]] : [label];
+}
