+/* ===================================================================== */
+/* cur5 — Workbench detail pages, bolder direction (ui-design-lead 2026-10-12) */
+/* ===================================================================== */
+
+/* Header: identity on the left (label, unit, tag, component, FG chips, category), actions on the right. */
+.wb3-dhead { padding: 16px 20px 12px; align-items: start; }
+.wb3-dhead .bmw-dh-sl .sensor-label-desc, .wb3-dhead h3 { font-size: 1.1rem; letter-spacing: -0.015em; }
+.wb3-meta-sep { width: 1px; height: 16px; background: var(--border-strong); margin: 0 4px; }
