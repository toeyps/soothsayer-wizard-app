+        scope={<>Replace <span className="fx-mono">{old}</span> everywhere in the formula with…</>} placeholder={`Replace ${old} with…`} />
+    </div>
+  );
+}
+
+function PreviewPlot({ values, empty }: { values: (number | null)[] | null; empty: string }) {
+  const cv = useRef<HTMLCanvasElement>(null);
+  useEffect(() => {
+    const c = cv.current; if (!c) return;
+    const r = c.getBoundingClientRect(); const dpr = Math.min(2, window.devicePixelRatio || 1);
+    c.width = Math.max(10, r.width * dpr); c.height = Math.max(10, r.height * dpr);
+    const ctx = c.getContext('2d'); if (!ctx) return;
+    ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, r.width, r.height);
+    if (!values || !values.length) return;
+    const ok = values.filter((v): v is number => v != null && Number.isFinite(v)); if (!ok.length) return;
+    const mn = Math.min(...ok), mx = Math.max(...ok), pad = (mx - mn || 1) * 0.1, lo = mn - pad, hi = mx + pad;
+    const W = r.width, H = r.height, L = 54, R = 10, T = 10, B = 10;
+    ctx.strokeStyle = 'rgba(255,255,255,.07)'; ctx.lineWidth = 1; ctx.font = '10.5px "JetBrains Mono", Consolas, monospace'; ctx.fillStyle = '#5b5b63'; ctx.textAlign = 'right';
+    for (let g = 0; g <= 4; g++) { const y = T + (H - T - B) * g / 4; ctx.beginPath(); ctx.moveTo(L, y); ctx.lineTo(W - R, y); ctx.stroke(); ctx.fillText((hi - (hi - lo) * g / 4).toLocaleString('en-US', { maximumFractionDigits: hi - lo < 10 ? 2 : 0 }), L - 6, y + 4); }
+    ctx.strokeStyle = 'oklch(.72 .15 245)'; ctx.lineWidth = 1.3; ctx.beginPath(); let pen = false;
+    values.forEach((v, i) => { const x = L + (W - L - R) * i / (values.length - 1); if (v == null || !Number.isFinite(v)) { pen = false; return; } const y = T + (H - T - B) * (1 - (v - lo) / (hi - lo)); if (!pen) { ctx.moveTo(x, y); pen = true; } else ctx.lineTo(x, y); });
+    ctx.stroke();
+  }, [values]);
+  return (
+    <div className="fx-plot">
+      <canvas ref={cv} />
+      {!values && <div className="fx-empty">{empty}</div>}
+    </div>
+  );
+}
+
+/* ─────────────────────────────────────────────────────────────────────────────
+ * Quick build — the selection-aware option sets of the old ButtonBuilder (SensorTooling.tsx),
+ * brought back as the friendly way to START a formula: what is offered depends only on how many
+ * sensors are picked on the left. It never commits anything hidden: the generated formula text is
+ * shown, then written into the editor (Use / Insert / Replace), where it can be edited freely.
+ * ───────────────────────────────────────────────────────────────────────────── */
+type NumOp = '+' | '-' | '*' | '/' | '^';
+type Wrap = null | 'abs' | 'sqrt' | 'log' | 'exp' | 'ceil' | 'floor' | 'round';
+const WRAPS: Exclude<Wrap, null>[] = ['abs', 'sqrt', 'log', 'exp', 'ceil', 'floor', 'round'];
+const WRAP_LBL: Record<string, string> = { sqrt: '√', log: 'log₁₀' };
+const OP_NAME: Record<NumOp, string> = { '+': 'add', '-': 'subtract', '*': 'multiply', '/': 'divide', '^': 'power' };
+type Combine = null | 'sum' | 'mean' | 'median' | 'spread' | 'absdiff' | 'eff';
+const wrapText = (inner: string, w: Wrap, dec: number) => (w === null ? inner : w === 'round' ? `round(${stepOf(dec)}, ${inner})` : `${w}(${inner})`);
+
+function QuickBuild({ selected, known, editorEmpty, onClear, onInsert, onReplace, onBlock }: {
+  selected: string[]; known: (t: string) => boolean; editorEmpty: boolean; onClear: () => void;
+  onInsert: (piece: string, hasTopOp: boolean) => void; onReplace: (piece: string) => void; onBlock: (fn: 'mean' | 'median', src: string[]) => void;
+}) {
+  const n = selected.length;
+  // 1 sensor
+  const [one, setOne] = useState<null | { k: 'num'; op: NumOp } | { k: 'fn'; fn: Exclude<Wrap, null> }>(null);
+  const [value, setValue] = useState('');
+  const [dec, setDec] = useState(2);
+  // 2+ sensors
+  const [chain, setChain] = useState<NumOp[]>([]);
+  const [combine, setCombine] = useState<Combine>(null);
+  const [base, setBase] = useState<string | null>(null);
+  const [wrap, setWrap] = useState<Wrap>(null);
+  const [wrapDec, setWrapDec] = useState(2);
+  const [signMenu, setSignMenu] = useState<null | { i: number; rect: PopoverAnchorRect }>(null);
+  const bucket = n === 0 ? 0 : n === 1 ? 1 : 2;
+  useEffect(() => { setOne(null); setValue(''); setCombine(null); setBase(null); setWrap(null); setSignMenu(null); }, [bucket]);
+  useEffect(() => {
+    if (base && !selected.includes(base)) setBase(null);
+    if (n !== 2 && (combine === 'absdiff' || combine === 'eff')) setCombine(null);
+  }, [selected, n, combine, base]);
+
+  if (n === 0) {
+    return (
+      <div className="fx-card fx-qb idle">
+        <div className="fx-ct">Quick build<span className="fx-r">0 picked</span></div>
+        <div className="fx-qbidle">Pick sensors on the left to get started — one sensor offers a number or a transform, two or more a chain and combinations. Or type straight into the formula below.</div>
+      </div>
+    );
+  }
+
+  const S = ref;
+  let formula = '';          // the text that will be written into the editor
+  let hasTopOp = false;      // needs ( ) when inserted into a non-empty formula
+  let block: null | { fn: 'mean' | 'median' } = null;
+  let ready = true;
+  let hint = '';
+  if (n === 1) {
+    const a = S(selected[0]);
+    if (!one) { formula = a; hint = 'As-is: the sensor itself. Pick a number or a transform to change it.'; }
+    else if (one.k === 'num') { const v = value.trim(); ready = v !== '' && !isNaN(Number(v)); formula = `${a} ${one.op} ${ready ? v : '…'}`; hasTopOp = true; hint = ready ? '' : 'Enter the number.'; }
+    else { formula = one.fn === 'round' ? `round(${stepOf(dec)}, ${a})` : `${one.fn}(${a})`; }
+  } else {
+    const refs = selected.map(S);
+    const list = refs.join(', ');
+    let inner = '';
+    if (combine === null || combine === 'sum') { inner = refs.map((r, i) => (i ? ` ${combine === 'sum' ? '+' : (chain[i - 1] ?? '+')} ${r}` : r)).join(''); hasTopOp = true; }
+    else if (combine === 'spread') { inner = `max(${list}) - min(${list})`; hasTopOp = true; }
+    else if (combine === 'absdiff') inner = `abs(${refs[0]} - ${refs[1]})`;
+    else if (combine === 'eff') { if (!base) { ready = false; hint = 'Mark which sensor is the input (100 %).'; inner = '(… / …) * 100'; } else { const out = selected.find(x => x !== base)!; inner = `(${S(out)} / ${S(base)}) * 100`; } hasTopOp = true; }
+    else block = { fn: combine };
+    if (!block) { formula = wrapText(inner, wrap, wrapDec); if (wrap) hasTopOp = false; }
+  }
+  const unknown = selected.filter(t => !known(t));
+  if (unknown.length) { ready = false; hint = `${unknown[0]} is not in this dataset.`; }
+
+  const pill = (on: boolean, label: React.ReactNode, onClick: () => void, title?: string, cls = '') => (
+    <button key={String(label)} type="button" className={`fx-k ${cls}${on ? ' on' : ''}`} aria-pressed={on} onClick={onClick} title={title}>{label}</button>
+  );
+  return (
+    <div className="fx-card fx-qb">
+      <div className="fx-ct">Quick build
+        <span className="fx-qbsel">{n === 1 ? <SensorInline tag={selected[0]} size="sm" /> : `${n} sensors picked`}</span>
+        <span className="fx-r"><button type="button" className="fx-link" onClick={onClear}>Clear picks</button></span>
+      </div>
+      {n === 1 ? (
+        <div className="fx-qbbody">
+          <div className="fx-qbrow"><span className="fx-cap">Combine with a number</span>
+            {(['+', '-', '*', '/', '^'] as NumOp[]).map(op => pill(one?.k === 'num' && one.op === op, SYM[op], () => setOne(one?.k === 'num' && one.op === op ? null : { k: 'num', op }), OP_NAME[op], 'op'))}
+            {one?.k === 'num' && <input className="fx-qbin" aria-label="Value" placeholder="value" autoFocus value={value} onChange={e => setValue(e.target.value)} />}
+          </div>
+          <div className="fx-qbrow"><span className="fx-cap">Transform</span>
+            {WRAPS.map(f => pill(one?.k === 'fn' && one.fn === f, WRAP_LBL[f] ?? f, () => setOne(one?.k === 'fn' && one.fn === f ? null : { k: 'fn', fn: f }), FN_HELP[f], 'fn'))}
+            {one?.k === 'fn' && one.fn === 'round' && <label className="fx-qbdec">decimals <input className="fx-qbin sm" type="number" min={0} max={6} value={dec} onChange={e => setDec(Math.max(0, Math.min(6, Number(e.target.value) || 0)))} /></label>}
+          </div>
+        </div>
+      ) : (
+        <div className="fx-qbbody">
+          <div className="fx-qbrow chain"><span className="fx-cap">Chain</span>
+            <span className={`fx-chain${combine && combine !== 'sum' ? ' off' : ''}`}>
+              {selected.map((t, i) => (
+                <span key={t} className="fx-chainitem">
+                  {i > 0 && (
+                    <button type="button" className="fx-sign" disabled={!!combine} title={combine ? 'Signs are off while a combination is chosen' : 'Change the sign'} aria-label={`Sign before ${t}`}
+                      onClick={(e) => { const r = e.currentTarget.getBoundingClientRect(); setSignMenu({ i: i - 1, rect: { top: r.top, bottom: r.bottom, left: r.left, right: r.right } }); }}>
+                      {SYM[combine === 'sum' ? '+' : (chain[i - 1] ?? '+')]}
+                    </button>
+                  )}
+                  <SensorInline tag={t} size="sm" />
+                </span>
+              ))}
+            </span>
+            {!combine && <span className="fx-hint">+ by default — click a sign to change it</span>}
+          </div>
+          <div className="fx-qbrow"><span className="fx-cap">Combine all</span>
+            {pill(combine === 'sum', 'Sum', () => setCombine(combine === 'sum' ? null : 'sum'), 'A + B + C — a row is missing if any source is missing')}
+            {pill(combine === 'mean', 'Average', () => setCombine(combine === 'mean' ? null : 'mean'), 'Average block — missing values are skipped')}
+            {pill(combine === 'median', 'Median', () => setCombine(combine === 'median' ? null : 'median'), 'Median block — missing values are skipped')}
+            {pill(combine === 'spread', 'Spread', () => setCombine(combine === 'spread' ? null : 'spread'), 'max(…) − min(…)')}
+            {n === 2 && pill(combine === 'absdiff', '|A − B|', () => setCombine(combine === 'absdiff' ? null : 'absdiff'), 'abs(A − B)')}
+          </div>
+          {n === 2 && (
+            <div className="fx-qbrow"><span className="fx-cap">Compare one against the rest</span>
+              {pill(combine === 'eff', 'Efficiency %', () => setCombine(combine === 'eff' ? null : 'eff'), '(output ÷ input) × 100')}
+              {combine === 'eff' && selected.map(t => (
+                <label key={t} className="fx-qbradio"><input type="radio" name="fx-qb-base" checked={base === t} onChange={() => setBase(t)} /> input = <SensorInline tag={t} size="sm" /></label>
+              ))}
+            </div>
+          )}
+          {!block && (
+            <div className="fx-qbrow"><span className="fx-cap">Then wrap</span>
+              {WRAPS.map(f => pill(wrap === f, WRAP_LBL[f] ?? f, () => setWrap(wrap === f ? null : f), FN_HELP[f], 'fn'))}
+              {wrap === 'round' && <label className="fx-qbdec">decimals <input className="fx-qbin sm" type="number" min={0} max={6} value={wrapDec} onChange={e => setWrapDec(Math.max(0, Math.min(6, Number(e.target.value) || 0)))} /></label>}
+            </div>
+          )}
+        </div>
+      )}
+      <div className="fx-qbout">
+        <span className="fx-cap">{block ? 'Block' : 'Formula'}</span>
+        <code className={`fx-qbformula${ready ? '' : ' dim'}`}>{block ? `${AGG_NAME[block.fn]} of ${n} sensors · missing values skipped` : formula}</code>
+        <span className="fx-qbact">
+          {block ? (
+            <button type="button" className="fx-btn pri" disabled={!ready} onClick={() => onBlock(block!.fn, selected)}>{editorEmpty ? 'Use this block' : 'Replace with this block'}</button>
+          ) : editorEmpty ? (
+            <button type="button" className="fx-btn pri" disabled={!ready} onClick={() => onReplace(formula)}>Use this formula</button>
+          ) : (
+            <>
+              <button type="button" className="fx-btn" disabled={!ready} onClick={() => onInsert(formula, hasTopOp)}>Insert at cursor</button>
+              <button type="button" className="fx-btn pri" disabled={!ready} onClick={() => onReplace(formula)}>Replace formula</button>
+            </>
+          )}
+        </span>
+        {hint && <span className={`fx-hint full${ready ? '' : ' warn'}`}>{hint}</span>}
+      </div>
+      {signMenu && (
+        <AnchoredPopover anchorRect={signMenu.rect} onRequestClose={() => setSignMenu(null)} style={{ width: 150, padding: 4, maxHeight: 'none', overflow: 'visible' }}>
+          <div className="fx-menu" role="menu">
+            {(['+', '-', '*', '/', '^'] as NumOp[]).map(op => (
+              <button key={op} type="button" role="menuitem" className="fx-mitem fn" onClick={() => { setChain(c => { const nx = c.slice(); nx[signMenu.i] = op; return nx; }); setSignMenu(null); }}>
+                <span className="fx-mono">{SYM[op]}</span><small>{OP_NAME[op]}</small>
+              </button>
+            ))}
+          </div>
+        </AnchoredPopover>
+      )}
+    </div>
+  );
+}
+
+type TplKind = 'sum' | 'mean' | 'median' | 'spread' | 'absdiff' | 'eff';
+const TPL: Record<TplKind, { n: string; min: number; max?: number; f: string; help: string }> = {
+  sum: { n: 'Sum', min: 2, f: 'A + B + C …', help: 'Adds the sensors. A row is missing if any source is missing.' },
+  mean: { n: 'Average', min: 2, f: 'Average block', help: 'Average of the sensors. Missing values are skipped; a row is missing only when every source is.' },
+  median: { n: 'Median', min: 2, f: 'Median block', help: 'Middle value of the sensors. Missing values are skipped.' },
+  spread: { n: 'Spread', min: 2, f: 'max(A, B, …) − min(A, B, …)', help: 'Highest minus lowest. A row is missing if any source is missing.' },
+  absdiff: { n: '|A − B|', min: 2, max: 2, f: 'abs(A − B)', help: 'Size of the difference between two sensors.' },
+  eff: { n: 'Efficiency %', min: 2, max: 2, f: '(output ÷ input) × 100', help: 'Pick two sensors, then mark which one is the input (100 %).' },
+};
+
+function TemplatePicker({ kind, editAgg, sensors, initial, onCancel, onOk }: { kind: TplKind; editAgg: boolean; sensors: string[]; initial: string[]; onCancel: () => void; onOk: (src: string[], base: string | null) => void }) {
+  const T = TPL[kind];
+  const [sel, setSel] = useState<string[]>(initial);
+  const [base, setBase] = useState<string | null>(null);
+  const [q, setQ] = useState('');
+  const list = useMemo(() => { const s = q.trim().toLowerCase(); return s ? sensors.filter(t => sensorHaystack(t).includes(s)) : sensors; }, [q, sensors]);
+  const full = !!T.max && sel.length >= T.max;
+  let reason = '', warn = false;
+  if (sel.length < T.min) { reason = `Pick at least ${T.min} sensors.`; warn = true; }
+  else if (kind === 'eff' && !base) { reason = 'Mark which sensor is the input (100 %).'; warn = true; }
+  else reason = editAgg ? `Keeps it an ${T.n} of ${sel.length} sensors.` : `Inserts ${T.f.replace(/A, B, …|A \+ B \+ C …/, `${sel.length} sensors`)} at the cursor.`;
+  const toggle = (t: string) => { setSel(s => (s.includes(t) ? s.filter(x => x !== t) : [...s, t])); if (base === t) setBase(null); };
+  return (
+    <Portal>
+      <div className="pk-scrim" onMouseDown={onCancel} role="presentation">
+        <div className="pk-modal fx-tplm" role="dialog" aria-modal="true" aria-label={T.n} onMouseDown={e => e.stopPropagation()} onKeyDown={e => { if (e.key === 'Escape') { e.preventDefault(); onCancel(); } }}>
+          <div className="fx-mh"><b>{editAgg ? 'Edit the sources' : T.n}</b><p><code>{T.f}</code> · {T.help}</p></div>
+          <div className="pk-search"><Search size={13} /><input autoFocus value={q} onChange={e => setQ(e.target.value)} placeholder="Search description, tag, unit or component…" aria-label="Search sensors" /></div>
+          <div className="pk-scope">All sensors except this sensor and the sensors built on it · {sensors.length}</div>
+          <div className="fx-mb">
+            {list.map(t => {
+              const on = sel.includes(t), off = !on && full;
+              return (
+                <label key={t} className={off ? 'off' : ''} title={sensorTitle(t)}>
+                  <input type="checkbox" checked={on} disabled={off} onChange={() => toggle(t)} />
+                  <SensorLabel tag={t} />
+                  {kind === 'eff' && on ? <span className="fx-base"><input type="radio" name="fx-base" checked={base === t} onChange={() => setBase(t)} /> input</span> : <span />}
+                </label>
+              );
+            })}
+          </div>
+          <div className="pk-foot">
+            <span className={`cnt${warn ? ' fx-warn' : ''}`}>{reason}</span>
+            <span style={{ display: 'flex', gap: 8 }}>
+              <button type="button" className="pk-btn" onClick={onCancel}>Cancel</button>
+              <button type="button" className="pk-btn pri" disabled={warn} onClick={() => onOk(sel, base)}><Check size={13} /> OK · {sel.length}</button>
+            </span>
+          </div>
+        </div>
+      </div>
+    </Portal>
+  );
+}
