+.wb3-sharekey i { width: 8px; height: 8px; border-radius: 2px; }
+.wb3-sharekey b { font-family: var(--mono); color: var(--text-secondary); font-weight: 600; }
+
+/* Health score page: one column — ruler, then the stacked charts. */
+.wb3-board.hs-board { grid-template-columns: minmax(0, 1fr); }
+.wb3-board.hs-board > * { grid-column: 1 / -1; }
+
+/* The score ruler. */
+.wb3-rulercard { gap: 0; padding-bottom: 12px; }
+.wb3-ruler { --n: 5; position: relative; margin: 14px auto 8px; width: min(100% - 156px, 1100px); }
+.wb3-ruler-scores, .wb3-ruler-names, .wb3-ruler-values { position: relative; height: 18px; }
+.wb3-ruler-scores > span, .wb3-ruler-names > span, .wb3-ruler-values > span { position: absolute; transform: translateX(-50%); white-space: nowrap; }
+.wb3-ruler-sc { font: 700 13px var(--mono); letter-spacing: -0.02em; }
