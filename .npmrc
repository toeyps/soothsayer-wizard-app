# Project npm settings — applies to both local installs and CI.
#
# legacy-peer-deps: needed because two of our deps lag behind on peer ranges:
#   - echarts-gl@2.x  peers echarts@^5  but works fine with echarts@6
#   - (resolved) @testing-library/react-hooks  peers react@17
# Removing this flag will cause `npm ci` to ERESOLVE-fail on a fresh install.
# Re-evaluate once echarts-gl ships a v3 with updated peers.
legacy-peer-deps=true
