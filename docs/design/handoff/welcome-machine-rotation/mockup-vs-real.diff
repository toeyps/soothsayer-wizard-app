+
+export type Axis = 'x' | 'y' | 'z';
+
+/** `group = colour + PART_STEP × part`. */
+export const PART_STEP = 4;
+/** Floats per part pose: a 3×4 matrix, rows x′ y′ z′, columns x y z 1. */
+export const PART_STRIDE = 12;
