+const STEP = 10 * 60_000;
+const pad2 = (n: number) => String(n).padStart(2, '0');
+const toMsLocal = (v: string) => { const t = (v ?? '').trim().replace(' ', 'T'); const ms = new Date(/^\d{4}-\d{2}-\d{2}$/.test(t) ? `${t}T00:00` : t).getTime(); return Number.isNaN(ms) ? null : ms; };
