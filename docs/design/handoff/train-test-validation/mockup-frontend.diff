+import { Fragment, type ReactNode } from 'react';
+import type { HealthPreview, TestPeriodResult, ValidationResult } from '../../../types/health';
+import { fmtNum } from './chartTheme';
+import { formatDate, formatPeriodChip, parseLocal } from '../periodDisplay';
+import type { TimeScopes } from './healthCharts';
+
+/*
+ * MOCKUP (Train/Test validation, 2026-10-07). Two read-only cards built from
+ * `HealthPreview.test_validation`:
+ *
+ *   TrainTestCard    Model fit page — the model's numbers on the train rows vs
+ *                    each test period (per kind).
+ *   TestResultsCard  Health score page — what the health score did in each
+ *                    test period (false alarms / detection + lead time).
+ *
+ * Information only: nothing here blocks Train or Mark complete. Colours are
+ * green / amber only, never red (DESIGN_SYSTEM §4).
+ */
+
+// One date style everywhere (the Step-1 chips' formatPeriodChip / formatDate), no seconds.
+export const stamp = (s: string | null | undefined) => {
+    const ms = parseLocal(s);
+    if (ms === null) return s ?? '—';
+    const d = new Date(ms);
+    return `${formatDate(s)} ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
+};
+const range = (a: string | null, b: string | null) => formatPeriodChip({ id: '', start: a ?? '', end: b ?? '' });
+
+/** A drop / the lowest score count only when the score stays there for this long
+ *  (running time). Placeholder value, decided with [MIN DAYS] / [RECOMMENDED DAYS]. */
+export const DROP_SUSTAIN_HOURS = 1;
+
+export const NORMAL_AMBER_PCT = 5;
+
+/** The scope bands every Workbench time chart draws for this preview. */
+export function scopesOf(v: ValidationResult | null | undefined): TimeScopes | null {
+    if (!v) return null;
+    const many = v.train_ranges.length > 1;
+    return {
+        ranges: [
+            ...v.train_ranges.map((r, i) => ({ kind: 'train' as const, start: r.start, end: r.end, label: many ? `TRAIN P${i + 1}` : 'TRAIN', short: many ? `P${i + 1}` : 'TRAIN' })),
+            ...v.tests.map(t => ({ kind: t.label, start: t.start, end: t.end, label: `T${t.index} ${t.label === 'problem' ? 'KNOWN PROBLEM' : 'NORMAL'}`, short: `T${t.index} ${t.label === 'problem' ? 'PROBLEM' : 'NORMAL'}` })),
+        ],
+        events: v.tests.filter(t => t.label === 'problem' && t.event_time).map(t => t.event_time as string),
+    };
+}
+
+export function TestedPill({ n }: { n: number }) {
+    return <span className="f4-pill f4-pill--grey" data-testid="tested-pill" title="Test periods scored — information only">Tested · {n}</span>;
+}
+
+function ScopeName({ kind, text, sub }: { kind: 'train' | 'normal' | 'problem'; text: string; sub: string }) {
+    return (
+        <td className="vt-scopec">
+            <div className="vt-scope">
+                <i className={`tpe-sw ${kind === 'train' ? 'tpe-sw--tr' : `tpe-sw--te${kind === 'problem' ? ' tpe-sw--pb' : ''}`}`} />
+                <span><b>{text}</b><small>{sub}</small></span>
+            </div>
+        </td>
+    );
+}
+
+const pct = (x: number | undefined | null) => (x == null ? '—' : `${x.toFixed(1)}%`);
+const signed = (x: number | undefined | null, unit = '') => (x == null ? '—' : `${x > 0 ? '+' : x < 0 ? '−' : ''}${fmtNum(Math.abs(x))}${unit}`);
+
+/** Model fit page: train vs test numbers. */
+export function TrainTestCard({ data, unit, side = false, custom = false }: { data: HealthPreview; unit: string; /** In a side column (Individual / Clustering) instead of a full, capped row. */ side?: boolean; /** Custom-mode model: its test periods live in Model settings. */ custom?: boolean }) {
+    const v = data.test_validation;
+    if (!v) return null;
+    const u = unit ? ` ${unit}` : '';
+    const trainSub = `${v.train.days.toFixed(1)} d · ${v.train.rows.toLocaleString()} rows`;
+    const testSub = (t: TestPeriodResult) => `${range(t.start, t.end)} · ${t.days.toFixed(1)} d`;
+    const testName = (t: TestPeriodResult) => `T${t.index} ${t.label === 'problem' ? 'Known problem' : 'Normal'}`;
+
+    const head = (
+        <div className="wb2-card-h">
+            <b>Train vs test</b>
+            <span className="wb2-card-s">the same model, scored over each whole test period</span>
+        </div>
+    );
+
+    if (v.tests.length === 0) {
+        return (
+            <section className={side ? 'vt-card' : 'vt-card wb2-full vt-card--cap'} data-testid="train-test-card">
+                {head}
+                <div className="vt-none" data-testid="train-test-empty">
+                    <b>No test period yet.</b> Add one in {custom ? 'Model settings → Training data (Custom)' : 'Running condition → Edit'} (a Normal period and, if you have one, a Known problem) to see how this model does on data it never trained on. Needed before Mark complete.
+                </div>
+            </section>
+        );
+    }
+
+    let cols: string[];
+    let trainCells: ReactNode;
+    let testCells: (t: TestPeriodResult) => ReactNode;
+    let note: string;
+    if (data.kind === 'relationship') {
+        cols = ['R²', 'RMSE', 'Residual mean · SD', 'RMSE test / train'];
+        const tr = v.train;
+        trainCells = <><td className="n">{fmtNum(tr.r2 ?? NaN)}</td><td className="n">{fmtNum(tr.rmse ?? NaN)}{u}</td><td className="n">{signed(tr.residual_mean)} · {fmtNum(tr.residual_sd ?? NaN)}</td><td className="n vt-dim">1.00</td></>;
+        // Known problem: only the residual shift means something (the fit is expected to break).
+        testCells = t => t.label === 'problem'
+            ? <><td className="n vt-dim">—</td><td className="n vt-dim">—</td><td className="n" title="Residual shift: mean of actual − predicted">shift {signed(t.residual_mean, u)}</td><td className="n" title="Residual shift ÷ train RMSE">{tr.rmse ? `${(Math.abs(t.residual_mean ?? 0) / tr.rmse).toFixed(1)}× train RMSE` : '—'}</td></>
+            : <><td className="n">{fmtNum(t.r2 ?? NaN)}</td><td className="n">{fmtNum(t.rmse ?? NaN)}{u}</td><td className="n">{signed(t.residual_mean)} · {fmtNum(t.residual_sd ?? NaN)}</td><td className="n">{tr.rmse && t.rmse ? (t.rmse / tr.rmse).toFixed(2) : '—'}</td></>;
+        note = 'Normal periods: a ratio near 1 means the model predicts that normal data as well as its training data. Known problem: the residual shift is how far actual moved away from the prediction, on average.';
+    } else if (data.kind === 'individual') {
+        cols = ['Rows within ±3SD', 'Mean shift'];
+        trainCells = <><td className="n">{pct(v.train.within_3sd_pct)}</td><td className="n vt-dim">0 SD</td></>;
+        testCells = t => <><td className="n">{pct(t.within_3sd_pct)}</td><td className="n">{signed(t.mean_shift_sd, ' SD')}</td></>;
+        note = 'Mean shift is in train SDs. Normal periods should stay close to the train rows; a Known problem should move away from them.';
+    } else {
+        cols = ['Rows inside the 3× SD ring'];
+        trainCells = <td className="n">{pct(v.train.inside_3sd_ring_pct)}</td>;
+        testCells = t => <td className="n">{pct(t.inside_3sd_ring_pct)}</td>;
+        note = 'Normal periods should stay inside the ring like the train rows; a Known problem should fall outside it.';
+    }
+
+    return (
+        <section className={side ? 'vt-card' : 'vt-card wb2-full vt-card--cap'} data-testid="train-test-card">
+            {head}
+            <table className="vt-table">
+                <thead><tr><th>Scope</th>{cols.map(c => <th key={c} className="n">{c}</th>)}</tr></thead>
+                <tbody>
+                    <tr className="vt-train"><ScopeName kind="train" text={v.train_ranges.length > 1 ? `Train · ${v.train_ranges.length} periods` : 'Train'} sub={trainSub} />{trainCells}</tr>
+                    {v.tests.map(t => (
+                        <Fragment key={t.index}>
+                        <tr data-testid={`train-test-row-${t.index}`}>
+                            <ScopeName kind={t.label} text={testName(t)} sub={testSub(t)} />
+                            {t.rows === 0 ? <td className="n vt-dim" colSpan={cols.length}>No running rows in this period</td> : testCells(t)}
+                        </tr>
+                        {(t.train_rows ?? 0) > 0 && (
+                            <tr className="vt-ovrow" data-testid={`train-test-overlap-${t.index}`}>
+                                <td colSpan={cols.length + 1}><span className="vt-info">T{t.index} includes {(t.train_days ?? 0).toFixed(1)} d of train running time — its numbers include rows the model was trained on.</span></td>
+                            </tr>
+                        )}
+                        </Fragment>
+                    ))}
+                </tbody>
+            </table>
+            <div className="vt-note">{note}</div>
+        </section>
+    );
+}
+
+/** Health score page: what the score did in each test period. */
+export function TestResultsCard({ data, scoreReady, custom = false }: { data: HealthPreview; scoreReady: boolean; custom?: boolean }) {
+    const v = data.test_validation;
+    if (!v) return null;
+    return (
+        <section className="hs-card hs-full vt-results" data-testid="test-results">
+            <div className="wb2-card-h">
+                <b>Test results</b>
+                <span className="wb2-card-s">information only — never blocks Mark complete</span>
+            </div>
+            {v.tests.length === 0 ? (
+                <div className="vt-none" data-testid="test-results-empty">
+                    <b>No test period.</b> Add one in {custom ? 'Model settings → Training data (Custom)' : 'Running condition → Edit'} — Mark complete needs at least one.
+                </div>
+            ) : (
+                <div className="vt-tiles">
+                    {v.tests.map(t => <ResultTile key={t.index} t={t} scoreReady={scoreReady} />)}
+                </div>
+            )}
+            {v.tests.length > 0 && <div className="vt-note">A drop counts when the score stays below 80 for at least {DROP_SUSTAIN_HOURS} hour of running time; “lowest” is the lowest score held for {DROP_SUSTAIN_HOURS} hour. Rows outside the train and test periods get no score.</div>}
+        </section>
+    );
+}
+
+function ResultTile({ t, scoreReady }: { t: TestPeriodResult; scoreReady: boolean }) {
+    const title = (
+        <div className="vt-th">
+            <i className={`tpe-sw tpe-sw--te${t.label === 'problem' ? ' tpe-sw--pb' : ''}`} />
+            <b>T{t.index} {t.label === 'problem' ? 'Known problem' : 'Normal'}</b>
+            <span>{range(t.start, t.end)} · {t.days.toFixed(1)} d running time</span>
+        </div>
+    );
+    const ovNote = (t.train_rows ?? 0) > 0
+        ? <div className="vt-info" data-testid={`test-result-overlap-${t.index}`}>Includes {(t.train_days ?? 0).toFixed(1)} d of train running time — results include rows the model was trained on.</div>
+        : null;
+    if (t.rows === 0) {
+        return <div className="vt-tile" data-testid={`test-result-${t.index}`} data-tone="none">{title}{ovNote}<div className="vt-big vt-dim">No running rows</div><div className="vt-det">The running condition removes every row of this period.</div></div>;
+    }
+    if (!scoreReady || t.pct_below_80 === null) {
+        return <div className="vt-tile" data-testid={`test-result-${t.index}`} data-tone="none">{title}{ovNote}<div className="vt-big vt-dim">Not scored yet</div><div className="vt-det">Set valid points above to score this period.</div></div>;
+    }
+    if (t.label === 'normal') {
+        const amber = t.pct_below_80 >= NORMAL_AMBER_PCT;
+        return (
+            <div className="vt-tile" data-testid={`test-result-${t.index}`} data-tone={amber ? 'warn' : 'ok'}>
+                {title}{ovNote}
+                <div className="vt-big"><b>{t.pct_below_80.toFixed(1)}%</b> of running time below 80</div>
+                <div className="vt-det">
+                    {amber
+                        ? <>Many false alarms for a normal period. Check that this time really was normal, or widen the set points.</>
+                        : <>Few false alarms — the score stays high on normal data.</>}
+                    {t.lowest !== null && <> Lowest {t.lowest} (held {DROP_SUSTAIN_HOURS} h) on {stamp(t.lowest_at)}.</>}
+                </div>
+            </div>
+        );
+    }
+    const detected = t.first_below_80 !== null;
+    const before = t.lead_days !== null && t.lead_days >= 0;
+    const tone = detected && (t.lead_days === null || before) ? 'ok' : 'warn';
+    return (
+        <div className="vt-tile" data-testid={`test-result-${t.index}`} data-tone={tone}>
+            {title}{ovNote}
+            {!detected ? (
+                <>
+                    <div className="vt-big"><b>Not detected</b></div>
+                    <div className="vt-det">The score did not stay below 80 in this period{t.lowest !== null ? ` (lowest held ${DROP_SUSTAIN_HOURS} h: ${t.lowest})` : ''}. This model does not show this problem — another model may.</div>
+                </>
+            ) : t.lead_days === null ? (
+                <>
+                    <div className="vt-big"><b>Detected</b> · fell below 80 on {stamp(t.first_below_80)}</div>
+                    <div className="vt-det">Add the event time to this test period to see the lead time.{t.lowest !== null ? ` Lowest ${t.lowest} (held ${DROP_SUSTAIN_HOURS} h) on ${stamp(t.lowest_at)}.` : ''}</div>
+                </>
+            ) : before ? (
+                <>
+                    <div className="vt-big"><b>{t.lead_days.toFixed(1)} days</b> before the event</div>
+                    <div className="vt-det">Fell below 80 on {stamp(t.first_below_80)} · event {stamp(t.event_time)}.{t.lowest !== null ? ` Lowest ${t.lowest} (held ${DROP_SUSTAIN_HOURS} h) on ${stamp(t.lowest_at)}.` : ''}</div>
+                </>
+            ) : (
+                <>
+                    <div className="vt-big">Detected only <b>{Math.abs(t.lead_days).toFixed(1)} days after</b> the event</div>
+                    <div className="vt-det">Fell below 80 only on {stamp(t.first_below_80)}, after the event ({stamp(t.event_time)}).</div>
+                </>
+            )}
+        </div>
+    );
+}
