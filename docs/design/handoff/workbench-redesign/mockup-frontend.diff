diff --git a/cur3/app/src/App.css b/cur4/app/src/App.css
index 34724ff..43b2604 100644
--- a/cur3/app/src/App.css
+++ b/cur4/app/src/App.css
@@ -6026,3 +6026,258 @@ body {
     -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent);
             mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent);
 }
+
+
+/* =====================================================================
+   Build Model Workbench REDESIGN (ui-design-lead, 2026-10-09): calmer
+   hierarchy — one line of workspace context, identity-only header, one state
+   dot per tab, one status sentence in the footer, quiet charts, a table of set
+   points. Prefix wbx- / hsx- / rcc-line. Everything else reuses the tokens.
+   ===================================================================== */
+
+/* Step-1 card as ONE line once it is set */
+.rcc-card.rcc-line { padding: 8px 12px 8px 12px; gap: 12px; flex-wrap: nowrap; margin: 10px 16px 0; border-radius: 10px; background: var(--card-bg); }
+.rcc-num--sm { width: 24px; height: 24px; }
+.rcc-line-main { flex: 1; min-width: 0; display: flex; align-items: center; gap: 14px; font-size: 12px; color: var(--text-secondary); white-space: nowrap; overflow: hidden; }
+.rcc-line-main > b { color: var(--text-primary); font-weight: 600; font-size: 12.5px; }
+.rcc-line-main .rcc-line-item b { color: var(--text-primary); font-weight: 600; }
+.rcc-line-sep { width: 1px; height: 16px; background: var(--border-strong); flex-shrink: 0; }
+.rcc-line-item { display: inline-flex; align-items: center; gap: 6px; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
+.rcc-line-item .tpe-sw { flex-shrink: 0; }
+.rcc-line-dt { font: 11px var(--mono); color: var(--text-faint); }
+.rcc-line-warn { color: var(--warn); }
+.rcc-line-rows { font-size: 11.5px; }
+.rcc-line-rows b { font-family: var(--mono); }
+.rcc-line-strip { width: 150px; flex-shrink: 0; }
+.rcc-line-strip .f4-cov--mini .f4-strip { height: 7px; border-radius: 99px; }
+.rcc-line-strip .f4-strip-ax { display: none; }
+.rcc-line-more { color: var(--text-secondary); }
+.rcc-less { font: inherit; font-size: 11px; color: var(--text-secondary); background: none; border: 0; cursor: pointer; display: inline-flex; align-items: center; gap: 4px; text-transform: none; letter-spacing: 0; }
+.rcc-less:hover { color: var(--text-primary); }
+@container (max-width: 1100px) { .rcc-line-dt { display: none; } }
+@media (max-width: 1100px) { .rcc-line-dt { display: none; } .rcc-line-strip { display: none; } }
+
+/* Detail header: identity on the left, ONE control group on the right that wraps as a row */
+.bmw-dhead { padding: 12px 20px 10px; grid-template-columns: auto minmax(0, 1fr) auto; }
+.wbx-dh-ctl { display: flex; align-items: flex-start; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
+.wbx-dh-ctl .tq-sensortrain { display: flex; flex-direction: column; align-items: flex-end; }
+@container (max-width: 900px) {
+    .wbx-dh-ctl { grid-column: 1 / -1; justify-content: flex-start; }
+    .wbx-dh-ctl .tq-sensortrain { margin-left: auto; }
+    .wb2-pages { grid-column: auto; }
+}
+.f4-catseg button { font-size: 0.68rem; padding: 3px 9px; }
+
+/* Page switch: one segmented control — says WHERE, not how far */
+.wb2-pages { gap: 0; border: 1px solid var(--border-strong); border-radius: 8px; background: var(--input-bg); padding: 2px; }
+.wb2-pg { height: 26px; padding: 0 12px; border: 0; background: none; border-radius: 6px; color: var(--text-secondary); font-weight: 500; }
+.wb2-pg b { display: none; }
+.wb2-pg--on { background: var(--surface-hi); color: var(--text-primary); border: 0; box-shadow: 0 1px 2px rgba(0,0,0,.35); }
+
+/* Train sensor: weight follows the state; the caption is small and only one line */
+.tq-sensortrain .tq-why { font-size: 10.5px; margin-top: 3px; }
+
+/* Kind tabs: kind badge + name + ONE dot. Pills are gone. */
+.f4-tab { padding: 8px 10px 7px; }
+.f4-sdot { width: 7px; height: 7px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--text-faint); }
+.f4-sdot--need { background: var(--warn); box-shadow: none; }
+.f4-sdot--bad { background: var(--danger); box-shadow: none; }
+.f4-sdot--complete { background: var(--ok); box-shadow: none; }
+
+/* Model settings row: a quiet disclosure line */
+.bmw-sets { background: transparent; }
+.bmw-sets-h { padding: 7px 20px; font-size: 0.74rem; color: var(--text-secondary); }
+.bmw-sets-h b { color: var(--text-primary); font-weight: 600; }
+.bmw-sets-sum { font-size: 0.68rem; }
+
+/* Board: tighter rhythm; chart cards flat on the detail background */
+.wb2-board { padding: 10px 18px 14px; gap: 10px; }
+.wb2-card, .wb2-statc, .hs-card { border-radius: 10px; }
+.wb2-card-h { min-height: 24px; margin-bottom: 2px; }
+.wb2-card-s { font-size: 10.5px; }
+.wb2-stale { margin: 8px 18px 0; padding: 8px 12px; }
+
+/* Footer: pill + one sentence, at most one filled button */
+.wbx-foot { padding: 9px 14px; }
+.wbx-reason { font-size: 0.72rem; color: var(--text-secondary); }
+.f4-foot-reason--bad { color: var(--danger); }
+.wbx-reason .hs-path { font-size: 10.5px; color: var(--text-secondary); max-width: 360px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: inline-block; vertical-align: bottom; }
+.wbx-foot .rcx-btn { height: 30px; font-size: 0.74rem; }
+
+/* "Trained in the run" line on the Health score page: a line, not a card */
+.tq-hbanner { margin: 8px 18px 0; padding: 6px 10px; font-size: 11.5px; }
+
+/* Health set points as a small table */
+.hsx-card { gap: 0; }
+.hsx-table { display: flex; flex-direction: column; }
+.hsx-row { display: grid; grid-template-columns: 34px minmax(0, 1fr) 84px 84px; gap: 8px; align-items: center; padding: 7px 0; border-top: 1px solid var(--border); }
+.hsx-head { border-top: 0; padding: 2px 0 4px; font: 600 9.5px Inter, "Segoe UI", system-ui, sans-serif; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-faint); }
+.hsx-score { font: 700 14px var(--mono); }
+.hsx-row--ok .hsx-score { color: var(--ok); }
+.hsx-row--warn .hsx-score { color: var(--warn); }
+.hsx-row--danger .hsx-score { color: var(--danger); }
+.hsx-what { font-size: 11.5px; color: var(--text-primary); display: flex; flex-direction: column; gap: 1px; min-width: 0; }
+.hsx-what small { font-size: 10px; color: var(--text-faint); }
+.hsx-v { min-width: 0; }
+.hsx-ro { font: 500 12px var(--mono); color: var(--text-secondary); }
+.hsx-row .hs-num { height: 28px; padding: 0 7px; }
+.hsx-row .hs-num input { font-size: 12px; }
+.hsx-note { font-size: 10.5px; color: var(--text-faint); line-height: 1.45; padding: 0 0 8px 42px; }
+.hsx-note .hs-restore { font-size: 10.5px; }
+.hsx-row .hs-kstep { grid-column: span 1; }
+.hsx-row .hs-quick { margin-top: 0; }
+.hsx-checks { border-top: 1px solid var(--border); padding-top: 9px; margin-top: 2px; }
+.hsx-checks-in .hs-checks { gap: 5px; }
+.hsx-checks-in .hs-chk { font-size: 11px; }
+@container (max-width: 1100px) { .hsx-row { grid-template-columns: 30px minmax(0, 1fr) 76px 76px; } }
+
+/* Health score page: the right column a little narrower, the two charts breathe;
+   under ~900 px of detail width the chart goes full width and the table follows it */
+.hs-board, .wb2-hs { grid-template-columns: minmax(0, 1fr) 320px; }
+.hs-setwrap .wb2-cv { min-height: 300px; }
+@container (max-width: 900px) {
+    .hs-board, .wb2-hs, .wb2-g2 { grid-template-columns: minmax(0, 1fr); }
+    .hsx-row { grid-template-columns: 34px minmax(0, 1fr) 110px 110px; }
+}
+
+/* Scoring periods (direction B, 2026-10-09): optional "what happened" as three quiet options */
+.tpe-lab--3 button { font-size: 10.5px; padding: 3px 8px; white-space: nowrap; }
+
+
+/* =====================================================================
+   Running condition modal REDESIGN (ui-design-lead, 2026-10-09): timeline
+   hero + three sections of one-line rows; no right column, no callout boxes.
+   ===================================================================== */
+.rcm-body--x { grid-template-columns: minmax(0, 1fr); }
+.rcm-form--x { padding: 4px 22px 18px; }
+.bmw-modal--rc { width: min(980px, 100%); }
+
+/* timeline hero */
+.rct { margin: 10px 0 6px; padding: 10px 12px 8px; border: 1px solid var(--border); border-radius: 12px; background: var(--bg-primary); }
+.rct-axis { position: relative; height: 14px; margin: 0 0 4px 52px; border-bottom: 1px solid var(--border-strong); }
+.rct-axis span { position: absolute; top: -2px; transform: translateX(-50%); font: 10px var(--mono); color: var(--text-faint); white-space: nowrap; }
+.rct-axis span::after { content: ''; position: absolute; left: 50%; bottom: -5px; width: 1px; height: 4px; background: var(--border-strong); }
+.rct-lane { position: relative; height: 26px; margin: 6px 0 0 52px; background: rgba(255,255,255,.03); border-radius: 6px; }
+.rct-ln { position: absolute; left: -52px; top: 0; height: 100%; width: 46px; display: flex; align-items: center; font-size: 10.5px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--text-faint); }
+.rct-blk { position: absolute; top: 3px; bottom: 3px; border-radius: 5px; display: flex; align-items: center; padding: 0 6px; font: 600 10px var(--mono); color: var(--text-primary); overflow: hidden; white-space: nowrap; }
+.rct-lane--tr .rct-blk { background: oklch(.68 .17 245 / .32); border: 1px solid oklch(.68 .17 245 / .7); }
+.rct-lane--sc .rct-blk { background: oklch(.74 .16 340 / .22); border: 1px dashed oklch(.74 .16 340 / .75); }
+.rct-blk.bad { background: var(--danger-muted); border-color: var(--danger); }
+.rct-empty { position: absolute; left: 8px; top: 0; height: 100%; display: flex; align-items: center; font-size: 11px; color: var(--text-faint); font-style: italic; }
+.rct-cap { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 8px; padding-top: 7px; border-top: 1px solid var(--border); font-size: 11.5px; color: var(--text-secondary); }
+.rct-cap b { color: var(--text-primary); font-family: var(--mono); }
+.rct-cap-tr, .rct-cap-sc { display: inline-flex; align-items: center; gap: 6px; }
+.rct-cap-min { color: var(--text-faint); margin-left: auto; }
+.rct-cap--warn .rct-cap-min { color: var(--warn); }
+
+/* sections: one eyebrow line each */
+.rcx-sec { padding: 14px 0 12px; border-bottom: 1px solid var(--border); }
+.rcx-sec:last-child { border-bottom: 0; }
+.rcx-sec-h { display: flex; align-items: baseline; gap: 8px; margin-bottom: 8px; font-size: 11.5px; color: var(--text-secondary); flex-wrap: wrap; }
+.rcx-sec-h b { font-size: 13px; font-weight: 600; color: var(--text-primary); }
+.rcx-sec-h .tpe-sw { align-self: center; }
+.rcx-line { font-size: 11.5px; color: var(--text-secondary); padding: 4px 0 0; }
+.rcx-line b { color: var(--text-primary); }
+.rcx-line--bad { color: var(--danger); }
+.rcx-line--warn { color: var(--warn); }
+
+/* period rows: one quiet line each, not a card */
+.rcm-form--x .rcm-per { background: none; border: 0; border-radius: 0; padding: 3px 0; gap: 8px; grid-template-columns: 30px 190px 18px 190px 50px 28px; }
+.rcm-form--x .tpe-per { grid-template-columns: 30px 190px 18px 190px 50px 28px; box-shadow: none; }
+.rcm-form--x .rcm-per--bad { background: var(--danger-muted); border-radius: 8px; padding: 3px 6px; }
+.rcm-form--x .rcm-per--ovl { background: none; }
+.rcm-form--x .rcm-per .f4-dtw, .rcm-form--x .tpe-per .f4-dtw { height: 28px; border-radius: 6px; }
+.rcm-form--x .rcm-per .f4-dtw input, .rcm-form--x .tpe-per .f4-dtw input { font-size: 11.5px; padding-left: 7px; }
+.rcm-form--x .rcm-pn, .rcm-form--x .tpe-pn { font: 600 11px var(--mono); }
+.rcm-form--x .rcm-dur { font: 11px var(--mono); color: var(--text-secondary); text-align: right; }
+.rcm-form--x .rcm-periods, .rcm-form--x .tpe-periods { gap: 2px; }
+.rcm-form--x .rcm-add { height: 28px; border-radius: 7px; width: auto; padding: 0 12px; font-size: 11.5px; justify-content: flex-start; margin-top: 4px; }
+.rcm-form--x .rcm-add-note { display: none; }
+.rcm-form--x .tpe-actions { display: flex; gap: 8px; align-items: center; margin-top: 2px; }
+.rcm-form--x .tpe-actions .rcx-btn { height: 28px; border-radius: 7px; font-size: 11.5px; }
+.rcm-form--x .rcm-cov { display: none; }
+.rcm-form--x .tpe-info--x, .rcm-form--x .rcm-permsg { grid-column: 2 / -1; font-size: 11px; color: var(--text-faint); padding: 0 0 2px; margin: 0; }
+.rcm-form--x .rcm-permsg--bad { color: var(--danger); }
+/* the highlight-overlap warning: one amber line with its action inline */
+.rcm-form--x .tpe-hlwarn { background: none; border: 0; padding: 2px 0 0 38px; margin: 0; font-size: 11.5px; color: var(--warn); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
+.rcm-form--x .tpe-hlwarn > i { display: none; }
+.rcm-form--x .tpe-hlwarn .rcx-btn { height: 24px; font-size: 11px; padding: 0 8px; }
+.rcm-form--x .rcm-none, .rcm-form--x .rcm-none--warn { background: none; border: 0; padding: 2px 0 4px; font-size: 11.5px; color: var(--text-secondary); }
+.rcm-form--x .rcm-none--warn { color: var(--warn); }
+
+/* running mode: one radio row instead of two cards */
+.rcx-mode { display: flex; gap: 14px; margin-bottom: 8px; }
+.rcx-mode .rcm-mcard { padding: 5px 10px 5px 8px; border-radius: 8px; align-items: center; background: none; }
+.rcx-mode .rcm-mcard--on { background: var(--accent-muted); }
+.rcx-mode .rcm-mcard b { display: inline; font-size: 12px; margin-right: 6px; }
+.rcx-mode .rcm-mcard small { font-size: 11px; }
+.rcm-form--x .rcm-cond { background: none; border: 0; padding: 3px 0; grid-template-columns: minmax(0, 1fr) auto 150px 28px; }
+.rcm-form--x .rcm-cond .sensor-picker-trigger-single { height: 28px; border-radius: 6px; font-size: 11.5px; }
+.rcm-form--x .rcm-conds { gap: 2px; }
+.rcm-form--x .rcm-join { padding: 2px 0 2px 2px; }
+
+/* MOCKUP run 2 (2026-10-09): what Apply does to the models — amber, never red; Apply stays enabled. */
+.rc-impact { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; font-size: 11.5px; color: var(--warn); text-align: right; max-width: 560px; }
+.rc-impact > span { display: inline-flex; align-items: center; gap: 5px; }
+.rc-impact > span + span { color: var(--text-secondary); font-size: 11px; }
+.rc-impact--none, .rc-impact--none > span { color: var(--text-secondary); }
+
+/* MOCKUP run 3 (2026-10-09): Clustering set-point table — 100 / 80 rows are text, the 0 row's N control on its own line. */
+.hsx-table--cl .hsx-row { grid-template-columns: 34px minmax(0, 1fr) 64px; }
+.hsx-table--cl .hsx-row.hsx-head { display: none; }
+.hsx-ctl { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; padding: 0 0 8px 42px; }
+.hsx-ctl .hs-quick { display: inline-flex; gap: 4px; margin: 0; }
+.hsx-ctl .hs-num--ring { width: 96px; }
+/* Side card of the Clustering fit page: the period note wraps instead of widening the table. */
+.vt-card .vt-ovrow .vt-info { white-space: normal; }
+.vt-card { overflow: hidden; }
+
+.vt-card:not(.vt-card--cap) .vt-table { table-layout: fixed; }
+.vt-card:not(.vt-card--cap) .vt-table th.n, .vt-card:not(.vt-card--cap) .vt-table td.n { width: 96px; white-space: normal; }
+.vt-card:not(.vt-card--cap) .vt-scope, .vt-card:not(.vt-card--cap) .vt-scope small { white-space: normal; overflow-wrap: anywhere; }
+
+/* MOCKUP run 4a (2026-10-09): board messages (not trained / training / failed / stale / not in memory). */
+.wbx-msg { border-style: dashed; }
+.wbx-msg > div { display: flex; flex-direction: column; align-items: center; gap: 6px; max-width: 520px; }
+.wbx-msg-t { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 600; color: var(--text-primary); }
+.wbx-msg-s { font-size: 12px; color: var(--text-secondary); line-height: 1.5; }
+.wbx-msg-d { font: 11px var(--mono); color: var(--text-faint); }
+.wbx-msg--bad { border-color: color-mix(in oklab, var(--danger) 45%, transparent); }
+.wbx-msg--bad .wbx-msg-t { color: var(--danger); }
+.wbx-msg--run .wbx-msg-t { color: var(--accent-color); }
+
+.bmw-stage-empty[data-testid=results-incomplete] { align-content: center; justify-items: center; }
+
+/* MOCKUP run 4b: invalid period = a thin red edge on the row + one reason line under it. */
+.rcm-form--x .rcm-per--bad { background: none; border-radius: 0; padding: 3px 0 3px 6px; box-shadow: inset 2px 0 0 var(--danger); }
+.rcm-form--x .rcm-per--bad .f4-dt-end .f4-dtw, .rcm-form--x .rcm-per--bad .f4-dtw:last-of-type { border-color: var(--danger-line); }
+.rcm-form--x .rcm-permsg--bad { display: block; color: var(--danger); }
+.rcm-form--x .rcm-permsg--bad::before { margin-right: 6px; }
+/* Custom running condition inside Model settings: the modal's panel, without the modal's padding. */
+.rc-custom-panel .rcm-body--x { padding: 0; max-height: none; overflow: visible; }
+.rc-custom-panel .rcm-form--x { padding: 4px 0 6px; }
+
+/* Run 5a (reviewer must-fixes) */
+.tq-note { color: var(--warn); }
+.rcm-form--x .rcm-cond { grid-template-columns: minmax(0, 360px) auto 150px 28px; justify-content: start; }
+.rcm-form--x .rcm-cond--between { grid-template-columns: minmax(0, 360px) auto 236px 28px; }
+.rcc-card--req .rcc-num, .rcc-card--bad .rcc-num { font-weight: 700; }
+.wb2-stats .sl-inline-wrap { vertical-align: baseline; }
+
+.tq-err.tq-note { color: var(--warn); }
+.wb2-statc .wb2-card-h { flex-wrap: wrap; row-gap: 2px; }
+
+/* Run 5b (reviewer should-fixes) */
+.wbx-dt { font-family: var(--mono); font-size: 0.95em; }
+.vt-quiet { font-size: 12px; color: var(--text-faint); padding: 2px 0 4px; }
+.bmw-dmeta { display: flex; flex-wrap: wrap; gap: 4px 6px; align-items: center; }
+.tq-hbanner { flex-wrap: nowrap; }
+.tq-hbanner .tq-hb-line { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.tq-hbanner .tq-btn { white-space: nowrap; flex: none; }
+.rcm-form--x .rcm-per, .rcm-form--x .tpe-per { grid-template-columns: 30px 190px 18px 190px minmax(50px, max-content) 28px; }
+.rcm-form--x .rcm-dur { white-space: nowrap; text-align: left; }
+.rcm-run { color: var(--text-faint); }
+@container (max-width: 900px) { .wbx-dh-ctl { flex-wrap: nowrap; } }
+@media (prefers-reduced-motion: reduce) {
+    .pm-spin, .spinner, .animate-spin, .section-badge-loading { animation: none !important; }
+}
