+/* ---------------------------------------------------------------------------
+   TAGGED POINTS v2 (design 2026-10-12, mockup) — the "Tagged points" tab reads as a
+   table that belongs to the whole panel: the head band and the row lines cross the
+   full width, rows are 30 px, a point's head is two short lines (date, time) under
+   a rule in the tag's colour, the unit is printed once per row, and a hovered row
+   lights up. Overrides the first version's rules above; an implementation folds
+   the two blocks into one.
+   --------------------------------------------------------------------------- */
+.tag-table {
+    /* Docked fallback: head + five rows. */
+    max-height: 196px;
+}
+
+.tag-table--panel {
+    max-height: none;
+    display: flex;
+    flex-direction: column;
+}
+
+.tag-table-grid {
+    width: 100%;
+    justify-content: stretch;
+}
+
+.tag-table-row {
+    display: contents;
+}
+
+/* Head band */
+.tag-table-corner,
+.tag-table .chart-tag-item,
+.tag-table-fill--head {
+    position: sticky;
+    top: 0;
+    z-index: 2;
+    height: 44px;
+    box-sizing: border-box;
+    background: var(--surface-hi);
+    border-bottom: 1px solid var(--border-strong);
+}
+
+.tag-table-corner {
+    z-index: 3;
+    padding: 0 12px;
+}
+
+.tag-table-title {
+    padding: 0;
+    font-size: 10.5px;
+    font-weight: 600;
+    letter-spacing: 0.06em;
+    text-transform: uppercase;
+    color: var(--text-secondary);
+}
+
+/* A point's head: [dot] date / time [×]. The rule on top is the tag's colour — the
+   same colour as its dot and dashed line on the chart. */
+.tag-table .chart-tag-item {
+    justify-content: flex-end;
+    gap: 8px;
+    padding: 0 6px 0 12px;
+    box-shadow: inset 0 2px 0 var(--tag-c, transparent);
+    border-left: 1px solid rgba(255, 255, 255, 0.05);
+}
+
+.tag-table .chart-tag-dot {
+    width: 9px;
+    height: 9px;
+    box-shadow: 0 0 0 2px var(--surface-hi), 0 0 0 3px color-mix(in srgb, var(--tag-c, transparent) 45%, transparent);
+}
+
+.tag-table .chart-tag-label {
+    flex: 0 1 auto;
+    display: flex;
+    flex-direction: column;
+    align-items: flex-end;
+    gap: 1px;
+    line-height: 1.2;
+    font-size: 11px;
+}
+
+.chart-tag-date {
+    font-size: 10px;
+    color: var(--text-secondary);
+}
+
+.chart-tag-time {
+    font-size: 12px;
+    font-weight: 600;
+    color: var(--text-primary);
+}
+
+.chart-tag-date,
+.chart-tag-time {
+    max-width: 100%;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+/* The × is quiet until its column head is pointed at or holds focus — never hidden, so it
+   can always be found and tabbed to. */
+.tag-table .chart-tag-remove {
+    opacity: 0.45;
+}
+
+.tag-table .chart-tag-item:hover .chart-tag-remove,
+.tag-table .chart-tag-remove:focus-visible {
+    opacity: 1;
+}
+
+/* Rows */
+.tag-table-name,
+.tag-table-val,
+.tag-table-fill {
+    height: 30px;
+    box-sizing: border-box;
+    border-bottom: 1px solid rgba(255, 255, 255, 0.055);
+}
+
+.tag-table-name {
+    gap: 8px;
+    padding: 0 12px;
+    background: var(--card-bg);
+}
+
+.tag-table-swatch {
+    width: 9px;
+    height: 9px;
+    border-radius: 2px;
+}
+
+.tag-table-lead {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    width: 16px;
+    height: 16px;
+    border-radius: 4px;
+    background: rgba(255, 255, 255, 0.07);
+    color: var(--text-primary);
+}
+
+.tag-table-name .sensor-label,
+.tag-table-name .sensor-inline {
+    min-width: 0;
+}
+
+/* A narrow name cell gives its room to the description: the tag (still in the tooltip) hides
+   sooner here than the shared label's 150 px. */
+@container (max-width: 250px) {
+    .tag-table-name .sl-fit .sl-tag { display: none; }
+}
+
+/* The unit, once per row: at the right edge of the name cell, right before the numbers. */
+.tag-table-unit {
+    flex: none;
+    margin-left: auto;
+    padding-left: 10px;
+    font-family: 'JetBrains Mono', monospace;
+    font-size: 10px;
+    color: var(--text-secondary);
+    opacity: 0.8;
+    white-space: nowrap;
+}
+
+.tag-table-val {
+    /* 34 px on the right = the ×'s width + gap in the head, so a number ends exactly
+       under the end of its point's time. */
+    padding: 0 34px 0 12px;
+    border-left: 1px solid rgba(255, 255, 255, 0.05);
+    font-size: 12px;
+    font-weight: 500;
+    font-variant-numeric: tabular-nums;
+}
+
+.tag-table-val--none {
+    color: var(--text-secondary);
+    opacity: 0.55;
+    font-weight: 400;
+}
+
+.tag-table-row:hover > .tag-table-val,
+.tag-table-row:hover > .tag-table-fill {
+    background: rgba(255, 255, 255, 0.035);
+}
+
+.tag-table-row:hover > .tag-table-name {
+    /* Opaque (the cell is sticky and slides over the values): the card colour, lightened. */
+    background: color-mix(in srgb, var(--card-bg) 96.5%, #fff);
+}
+
+/* The count under the table; stays at the left edge when the table scrolls sideways. */
+.tag-table-foot {
+    position: sticky;
+    left: 0;
+    width: max-content;
+    max-width: 100%;
+    margin: 0;
+    padding: 8px 12px 10px;
+    font-size: 11px;
+    color: var(--text-secondary);
+}
+
+.tag-table-foot b {
+    font-family: 'JetBrains Mono', monospace;
+    font-weight: 600;
+    color: var(--text-primary);
+}
+
+/* No tagged point yet: the same sentence, centred in the tab instead of in its corner. */
+.tag-panel-empty {
+    margin: auto;
+    max-width: 440px;
+    padding: 1.25rem 1rem;
+    text-align: center;
+    font-size: 0.8rem;
+    line-height: 1.55;
+    opacity: 0.8;
+}
+
 /* =============================================
